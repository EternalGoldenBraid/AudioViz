<mxfile host="Electron" modified="2026-10-22T07:15:00.000Z" version="26.0.0">
  <diagram id="lesson-1-edge-precision" name="Lesson 1 — One Generative Edge">
    <mxGraphModel dx="1440" dy="920" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Banner -->
        <mxCell id="title" value="Lesson 1: Covariance-Weighted Predictive Coding on One Generative Edge" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#1e293b;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1360" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="From unit-variance prediction error to residual variance sigma^2 (precision pi = 1 / sigma^2), clamped vs. inferred targets, and AudioViz core mapping" style="text;strokeColor=none;fillColor=none;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;html=1;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1360" height="24" as="geometry" />
        </mxCell>

        <!-- Tier 1: Forward Prediction vs Backward Credit Assignment -->
        <mxCell id="lane-edge" value="1. One Generative Relationship: Forward Prediction (w) vs. Backward Error Credit Assignment (w^T)" style="swimlane;startSize=32;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1360" height="250" as="geometry" />
        </mxCell>

        <mxCell id="node-a" value="&lt;b&gt;Source State (a)&lt;/b&gt;&lt;br&gt;Activity: f(a) = tanh(a)&lt;br&gt;Slope: f&amp;#39;(a) = 1 - tanh(a)^2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane-edge">
          <mxGeometry x="40" y="60" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node-w" value="&lt;b&gt;Weight (w or W)&lt;/b&gt;&lt;br&gt;Prediction: b_hat = w * f(a)&lt;br&gt;(Vector: b_hat = W f(a))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="lane-edge">
          <mxGeometry x="330" y="60" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node-err" value="&lt;b&gt;Prediction Error (e)&lt;/b&gt;&lt;br&gt;e = b - b_hat = b - w * f(a)&lt;br&gt;(&quot;Target minus Prediction&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane-edge">
          <mxGeometry x="630" y="60" width="230" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node-b" value="&lt;b&gt;Target Node (b)&lt;/b&gt;&lt;br&gt;Either Clamped (observed data)&lt;br&gt;or Inferred (free internal state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane-edge">
          <mxGeometry x="940" y="60" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="node-energy" value="&lt;b&gt;Weighted Mismatch Energy (E)&lt;/b&gt;&lt;br&gt;Scalar: E = (1 / (2 * sigma^2)) * e^2 = 0.5 * pi * e^2&lt;br&gt;Vector: E = 0.5 * e^T * Sigma^-1 * e = 0.5 * e^T * Pi * e" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="lane-edge">
          <mxGeometry x="600" y="165" width="380" height="65" as="geometry" />
        </mxCell>

        <mxCell id="note-why-wt" value="&lt;b&gt;Why W^T appears in the source update:&lt;/b&gt;&lt;br&gt;Forward: column i of W sends activity f(a_i) to targets b_j.&lt;br&gt;Chain rule: d(b_hat_j)/da_i = W_{j,i} f&amp;#39;(a_i).&lt;br&gt;Backward: row i of W^T sums weighted errors (Pi e)_j." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="lane-edge">
          <mxGeometry x="40" y="160" width="520" height="72" as="geometry" />
        </mxCell>

        <mxCell id="note-ontology" value="&lt;b&gt;Key Distinction:&lt;/b&gt;&lt;br&gt;sigma^2 (or Pi = 1/sigma^2) here is the &lt;b&gt;relationship&amp;#39;s noise tolerance&lt;/b&gt; (how tightly b_hat must match b).&lt;br&gt;It is NOT yet a separate probability distribution of uncertainty over the node beliefs (a, b) themselves." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="lane-edge">
          <mxGeometry x="1010" y="155" width="320" height="78" as="geometry" />
        </mxCell>

        <!-- Edges inside Tier 1 -->
        <mxCell id="e-a-w" value="f(a)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontStyle=1;" edge="1" source="node-a" target="node-w" parent="lane-edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-w-err" value="b_hat" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontStyle=1;" edge="1" source="node-w" target="node-err" parent="lane-edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-b-err" value="+b" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontStyle=1;" edge="1" source="node-b" target="node-err" parent="lane-edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-err-energy" value="pi = 1/sigma^2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontStyle=1;" edge="1" source="node-err" target="node-energy" parent="lane-edge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Tier 2: Step-by-Step Derivatives & Clamped vs Inferred Target -->
        <mxCell id="lane-deriv" value="2. Small-Step Derivative Signs (Chain Rule on E = 0.5 * pi * (b - w * f(a))^2) &amp; Clamped vs. Inferred Target" style="swimlane;startSize=32;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="1360" height="255" as="geometry" />
        </mxCell>

        <mxCell id="box-grad-a" value="&lt;b&gt;1. Update Source State (a)&lt;/b&gt;&lt;br&gt;&lt;br&gt;de/da = -w * f&amp;#39;(a)&lt;br&gt;dE/da = (dE/de)(de/da) = -pi * e * w * f&amp;#39;(a)&lt;br&gt;&lt;b&gt;Gradient descent (da/dt = -dE/da):&lt;/b&gt;&lt;br&gt;da/dt = +pi * e * w * f&amp;#39;(a)&lt;br&gt;(Vector: da/dt = +f&amp;#39;(a) odot (W^T Pi e))&lt;br&gt;&lt;i&gt;Sign check: if e &amp;gt; 0 and w &amp;gt; 0, a increases to raise b_hat.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="lane-deriv">
          <mxGeometry x="30" y="50" width="410" height="185" as="geometry" />
        </mxCell>

        <mxCell id="box-grad-b" value="&lt;b&gt;2. Target Node (b): Clamped vs. Inferred&lt;/b&gt;&lt;br&gt;&lt;br&gt;de/db = +1  =&amp;gt;  &lt;b&gt;dE/db = +pi * e&lt;/b&gt;  (Vector: +Pi e)&lt;br&gt;&amp;#8226; &lt;b&gt;Case A — Clamped (Observed sensory data):&lt;/b&gt;&lt;br&gt;  b is fixed by camera/sensor. Only a and w move.&lt;br&gt;&amp;#8226; &lt;b&gt;Case B — Inferred (Unclamped internal state):&lt;/b&gt;&lt;br&gt;  db/dt = -dE/db = &lt;b&gt;-pi * e = -pi * (b - b_hat)&lt;/b&gt;&lt;br&gt;&lt;i&gt;Sign check: if e &amp;gt; 0 (b &amp;gt; b_hat), b is pulled DOWN toward b_hat.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="lane-deriv">
          <mxGeometry x="475" y="50" width="420" height="185" as="geometry" />
        </mxCell>

        <mxCell id="box-grad-w" value="&lt;b&gt;3. Update Weight (w or W)&lt;/b&gt;&lt;br&gt;&lt;br&gt;de/dw = -f(a)&lt;br&gt;dE/dw = (dE/de)(de/dw) = -pi * e * f(a)&lt;br&gt;&lt;b&gt;Gradient descent (Delta w = -eta * dE/dw):&lt;/b&gt;&lt;br&gt;Delta w = +eta * pi * e * f(a)&lt;br&gt;(Matrix: Delta W = +eta * (Pi e) f(a)^T)&lt;br&gt;&lt;i&gt;Local Hebbian rule: (post-error pi*e) x (pre-activity f(a)).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="lane-deriv">
          <mxGeometry x="930" y="50" width="400" height="185" as="geometry" />
        </mxCell>

        <!-- Tier 3: Exact Mapping to AudioViz ContinuousScenePredictiveCodingGraph -->
        <mxCell id="lane-code" value="3. How This Exact Single-Edge Rule Appears in AudioViz (continuous_scene_predictive_coding.py)" style="swimlane;startSize=32;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="645" width="1360" height="240" as="geometry" />
        </mxCell>

        <mxCell id="code-terms" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/continuous_scene_predictive_coding.py:290" value="&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/continuous_scene_predictive_coding.py:290&quot;&gt;&lt;b&gt;_terms_for: Fixed Weights in Interaction Energy E_int&lt;/b&gt;&lt;br&gt;Hidden error: e_h = h - W_h tanh(h) - W_c a_root, weight c_h = 0.25&lt;br&gt;Coupling error: e_z = z - W_s tanh(h), weight c_cpl * gamma_z&lt;br&gt;Full energy adds state-rest penalties and scales E_int by G = 20 * inference_rate.&lt;br&gt;The integrator subtracts the gradients; its metric divides the z gradient by gamma_z.&lt;br&gt;Observation y is clamped; neural potential z remains inferred through sigmoid(z).&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="lane-code">
          <mxGeometry x="30" y="50" width="640" height="170" as="geometry" />
        </mxCell>

        <mxCell id="code-weights" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/continuous_scene_predictive_coding.py:364" value="&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/continuous_scene_predictive_coding.py:364&quot;&gt;&lt;b&gt;_raw_weight_gradients &amp;amp; _weight_gradients (lines 364-389)&lt;/b&gt;&lt;br&gt;1. Raw Euclidean gradient (_raw_weight_gradients):&lt;br&gt;   dE_int/dW_s = -(c_cpl * gamma_z) * outer(e_z, tanh(h))   [has precision factor pi_cpl]&lt;br&gt;2. Preconditioned update (_weight_gradients divides by M_W = diag(c_h, c_h, c_cpl*gamma_z)):&lt;br&gt;   M_W^-1 dE_int/dW_s = -outer(e_z, tanh(h))   [cancels scalar pi_cpl so learning rate is uniform]&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="lane-code">
          <mxGeometry x="700" y="50" width="630" height="170" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

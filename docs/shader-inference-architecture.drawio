<mxfile host="Electron" version="31.7.0">
  <diagram id="shader-system" name="1 - System architecture">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AudioViz | Proposed first-class OpenGL inference backend" style="text;html=1;fontSize=26;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="50" as="geometry"/></mxCell>
        <mxCell id="legend" value="PROPOSAL ONLY | Green: existing components | Blue: new or extended components | Grey dashed: deferred topology extension" style="text;html=1;fontSize=15;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1510" height="35" as="geometry"/></mxCell>
        <mxCell id="host" value="HOST | Python / Qt" style="swimlane;html=1;startSize=40;fillColor=#f5f5f5;strokeColor=#666666;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="140" width="300" height="830" as="geometry"/></mxCell>
        <mxCell id="gpu" value="GPU | OpenGL 4.3 compute + graphics | No CUDA dependency" style="swimlane;html=1;startSize=40;fillColor=#f7faff;strokeColor=#6c8ebf;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="830" height="830" as="geometry"/></mxCell>
        <mxCell id="future" value="LATER | Variable neighborhoods" style="swimlane;html=1;startSize=40;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="140" width="300" height="830" as="geometry"/></mxCell>
        <mxCell id="camera" value="Camera capture&lt;br&gt;OpenCV / raw frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="host"><mxGeometry x="20" y="70" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="audio" value="Audio acquisition + analysis&lt;br&gt;Spectral bands + ON/OFF flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="host"><mxGeometry x="20" y="190" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="control" value="Frame orchestration&lt;br&gt;Config, source toggles, synthetic drives&lt;br&gt;Reset / rebuild / explicit errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="host"><mxGeometry x="20" y="330" width="260" height="120" as="geometry"/></mxCell>
        <mxCell id="reference" value="NumPy reference&lt;br&gt;Existing equations + seeded weights&lt;br&gt;Parity tests; not the GL frame path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="host"><mxGeometry x="20" y="490" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="ui" value="Qt UI / prediction layouts&lt;br&gt;Bounded host snapshots only&lt;br&gt;Images, curves, diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="host"><mxGeometry x="20" y="670" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="context" value="Renderer-owned GL context + frame entry&lt;br&gt;Evidence / drive uploads; dispatch on owning thread; barriers, reset and teardown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="gpu"><mxGeometry x="30" y="60" width="770" height="75" as="geometry"/></mxCell>
        <mxCell id="waves" value="Wave compute shader&lt;br&gt;Extend existing solver to RGB&lt;br&gt;Capture native prior; no full readback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="30" y="180" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="prediction" value="Pre-evidence prediction&lt;br&gt;Advance persistent hidden state&lt;br&gt;Save genuine expectations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="30" y="320" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="inference" value="Joint inference dispatches&lt;br&gt;Camera + audio + stream-state nodes&lt;br&gt;Local directions + global reductions&lt;br&gt;Optional hidden-to-hidden coupling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="30" y="455" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="learning" value="Validate, learn, commit correction&lt;br&gt;Weights fixed during settling&lt;br&gt;Correct BOTH wave time buffers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="30" y="610" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="render" value="Fragment shader presentation&lt;br&gt;Extend existing texture renderer to RGB&lt;br&gt;Render corrected canvas directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="30" y="745" width="330" height="65" as="geometry"/></mxCell>
        <mxCell id="resources" value="Backend-owned native resources&lt;br&gt;&lt;br&gt;RGB wave current / old / prior textures&lt;br&gt;Inference canvas + hidden ping-pong buffers&lt;br&gt;Frozen prediction + clamped evidence&lt;br&gt;Weights, errors, reduction scratch&lt;br&gt;&lt;br&gt;Explicit float32 mode; no fake NumPy arrays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="450" y="180" width="350" height="235" as="geometry"/></mxCell>
        <mxCell id="topology" value="Model connectivity / parameters&lt;br&gt;&lt;br&gt;Current RGB + hidden channel pathways&lt;br&gt;Shared predictive weights across pixels&lt;br&gt;Fixed substrate conductances are separate&lt;br&gt;&lt;br&gt;No arbitrary-edge execution in first port" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="450" y="455" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="snapshots" value="On-device preview + diagnostic sampling&lt;br&gt;2D: max side 512; 3D: 64; max 10 Hz&lt;br&gt;Small validity flags; opt-in diagnostics&lt;br&gt;Never full-field readback for inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="gpu"><mxGeometry x="450" y="680" width="350" height="130" as="geometry"/></mxCell>
        <mxCell id="future-rule" value="Topology is data.&lt;br&gt;Equations define semantics.&lt;br&gt;Backend chooses execution layout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontSize=17;fontStyle=1;" vertex="1" parent="future"><mxGeometry x="20" y="70" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="hemisphere-left" value="Region A&lt;br&gt;local stencil" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontSize=15;" vertex="1" parent="future"><mxGeometry x="20" y="240" width="110" height="100" as="geometry"/></mxCell>
        <mxCell id="hemisphere-right" value="Region B&lt;br&gt;local stencil" style="ellipse;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontSize=15;" vertex="1" parent="future"><mxGeometry x="170" y="240" width="110" height="100" as="geometry"/></mxCell>
        <mxCell id="sparse" value="Sparse bridge buffers&lt;br&gt;Offsets, neighbor IDs, edge parameters&lt;br&gt;Gather + combine with local directions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontSize=16;" vertex="1" parent="future"><mxGeometry x="20" y="410" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="future-edits" value="Topology edits at frame boundaries&lt;br&gt;Swap a validated graph version&lt;br&gt;No mid-step mutation&lt;br&gt;&lt;br&gt;Separate milestone after existing-model parity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;dashed=1;fontSize=16;" vertex="1" parent="future"><mxGeometry x="20" y="620" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="bottom" value="FIRST DELIVERY: restore the existing RGB predictive model on OpenGL, including learning, coupling, previews and direct display.&#xa;NOT YET: arbitrary topology, pose-medium port, Vulkan/WebGPU migration, or a guaranteed 30 FPS target. See page 2 for phase ordering." style="text;whiteSpace=wrap;html=1;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="1000" width="1530" height="70" as="geometry"/></mxCell>
        <mxCell id="e-camera" value="upload raw frame" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" source="camera" target="context" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-audio" value="bands + flags" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=1;" edge="1" source="audio" target="context" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-control" value="schedule" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="control" target="prediction" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-wave-predict" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="waves" target="prediction" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-predict-infer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="prediction" target="inference" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-infer-learn" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="inference" target="learning" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-learn-render" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="learning" target="render" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-native" value="native handles" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;fontSize=13;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="resources" target="prediction" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-topology" value="parameters" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" source="topology" target="inference" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-preview" value="sample" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="render" target="snapshots" parent="gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-readback" value="bounded readback" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=13;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" source="snapshots" target="ui" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1005" y="985"/><mxPoint x="350" y="985"/><mxPoint x="350" y="860"/></Array></mxGeometry></mxCell>
        <mxCell id="e-regions" value="bridges" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;dashed=1;fontSize=12;" edge="1" source="hemisphere-left" target="hemisphere-right" parent="future"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-future" value="later" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=13;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="sparse" target="topology" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="shader-phases" name="2 - Frame phases and milestones">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Shader inference | Exact frame phases before performance tuning" style="text;html=1;fontSize=26;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1510" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="One owning GL context / thread. Arrows imply dispatch ordering and the appropriate memory barrier, not CPU readback." style="text;html=1;fontSize=16;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="85" width="1510" height="40" as="geometry"/></mxCell>
        <mxCell id="wave" value="1 | Propagate + preserve prior&lt;br&gt;&lt;br&gt;RGB wave dynamics, current/old buffers&lt;br&gt;Copy native prior for net correction&lt;br&gt;Apply pending config at frame boundary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="440" height="115" as="geometry"/></mxCell>
        <mxCell id="predict" value="2 | Predict BEFORE fresh evidence&lt;br&gt;&lt;br&gt;Advance persistent hidden belief&lt;br&gt;Save camera + audio expectations&lt;br&gt;Do not replace these with final reconstructions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="440" height="115" as="geometry"/></mxCell>
        <mxCell id="evidence" value="3 | Acquire / upload / clamp&lt;br&gt;&lt;br&gt;GPU camera normalization + RGB + resize&lt;br&gt;Audio bands + explicit source ON/OFF&lt;br&gt;Missing samples remain unclamped" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="440" height="115" as="geometry"/></mxCell>
        <mxCell id="loop" value="4 | Repeat configured settling steps | Same weight version throughout" style="swimlane;html=1;startSize=45;fillColor=#f7faff;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="980" height="435" as="geometry"/></mxCell>
        <mxCell id="reduce" value="4a | Activations + pooled reductions&lt;br&gt;Audio spatial mean; stream-state logits&lt;br&gt;Partial sums then final reduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="loop"><mxGeometry x="30" y="90" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="errors" value="4b | Predictions + errors&lt;br&gt;Canvas / camera / audio / optional coupling&lt;br&gt;Read the SAME old canvas + hidden states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="loop"><mxGeometry x="550" y="90" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="directions" value="4c | Compute all directions&lt;br&gt;Sum branch contributions to canvas&lt;br&gt;Write scratch; do NOT mutate old states" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="loop"><mxGeometry x="550" y="270" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="advance" value="4d | Advance together + swap buffers&lt;br&gt;Apply canvas + both hidden updates&lt;br&gt;Make writes visible before next iteration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" vertex="1" parent="loop"><mxGeometry x="30" y="270" width="400" height="105" as="geometry"/></mxCell>
        <mxCell id="validate" value="5 | Final errors + finite validation&lt;br&gt;&lt;br&gt;Validate settled state before learning&lt;br&gt;Reduce validity to a small host flag&lt;br&gt;Explicit divergence errors, no silent fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="learn" value="6 | Optional learning, once per frame&lt;br&gt;&lt;br&gt;Reduce local weight gradients&lt;br&gt;Camera / audio / state / coupling weights&lt;br&gt;Preserve averaging, decay and clipping rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="560" y="700" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="correct" value="7 | Commit net sensory correction&lt;br&gt;&lt;br&gt;delta = settled canvas - wave prior&lt;br&gt;wave_current += delta&lt;br&gt;wave_old += delta&lt;br&gt;Preserve wave velocity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1100" y="700" width="440" height="140" as="geometry"/></mxCell>
        <mxCell id="present" value="8 | Direct RGB texture presentation&lt;br&gt;&lt;br&gt;Corrected canvas, not camera prediction&lt;br&gt;Display mapping in fragment shader&lt;br&gt;No full-frame CPU download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1100" y="920" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="preview" value="9 | Optional bounded snapshots&lt;br&gt;&lt;br&gt;Frozen pre-evidence predictions + targets&lt;br&gt;512 / 64 max side at 10 Hz&lt;br&gt;Clear missing evidence and stale views" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" vertex="1" parent="1"><mxGeometry x="560" y="920" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="next" value="Next frame&lt;br&gt;&lt;br&gt;Retain learned weights and hidden state&lt;br&gt;Apply validated config / future topology edits&lt;br&gt;Reset clears state, retains weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="milestones" value="IMPLEMENTATION GATES: A. RGB native state + context lifecycle | B. Camera inference parity | C. Audio + stream state + coupling + learning | D. UI previews + 1080p profiling&#xa;Sparse / hemispheric topology is a separate follow-on. Fuse passes only after parity; do not remove required reduction or synchronous-update boundaries." style="text;whiteSpace=wrap;html=1;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1500" height="75" as="geometry"/></mxCell>
        <mxCell id="e-wave-predict" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="wave" target="predict" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-predict-evidence" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="predict" target="evidence" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-enter-loop" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="evidence" target="reduce" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="520" y="547"/><mxPoint x="520" y="312"/></Array></mxGeometry></mxCell>
        <mxCell id="e-reduce-errors" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="reduce" target="errors" parent="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-errors-directions" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="errors" target="directions" parent="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-directions-advance" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="directions" target="advance" parent="loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-repeat" value="next step" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=14;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="advance" target="reduce" parent="loop"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="322"/><mxPoint x="10" y="142"/></Array></mxGeometry></mxCell>
        <mxCell id="e-exit-loop" value="settled" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="advance" target="validate" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="650"/><mxPoint x="260" y="650"/></Array></mxGeometry></mxCell>
        <mxCell id="e-validate-learn" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="validate" target="learn" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-learn-correct" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="learn" target="correct" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-correct-present" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="correct" target="present" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-present-preview" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="present" target="preview" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-preview-next" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="preview" target="next" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="shader-model" name="3 - Predictive model graph">
    <mxGraphModel dx="1560" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Predictive model | Existing equations, proposed OpenGL execution" style="text;html=1;fontSize=26;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1500" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Solid arrows: generative prediction pathways. Inference carries errors back through these pathways; it is not camera-to-canvas injection." style="text;html=1;fontSize=16;align=left;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1500" height="40" as="geometry"/></mxCell>
        <mxCell id="substrate" value="Spatial dynamics: separate operator&lt;br&gt;&lt;br&gt;Wave neighbors + fixed conductances&lt;br&gt;Propagate each RGB canvas channel&lt;br&gt;Not learned camera/audio weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="prior" value="RGB wave prior&lt;br&gt;Initial canvas for this settling frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="610" y="160" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="canvas" value="Shared canvas c&lt;br&gt;Rows x columns x 3&lt;br&gt;tanh(c) feeds both hidden branches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="610" y="300" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="visual-hidden" value="Persistent visual hidden field&lt;br&gt;Rows x columns x hidden channels&lt;br&gt;6 channels by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="200" y="500" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="audio-hidden" value="Persistent audio hidden field&lt;br&gt;Rows x columns x hidden channels&lt;br&gt;6 channels by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="camera" value="Camera RGB prediction / target&lt;br&gt;Per-pixel decoder of tanh(h_visual)&lt;br&gt;Target unclamped when sample absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="200" y="800" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="pool" value="Spatial mean of tanh(h_audio)&lt;br&gt;One shared spectral prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1020" y="650" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="audio" value="Audio spectrum prediction / target&lt;br&gt;Spectral-band decoder of pooled activity&lt;br&gt;Target unclamped when sample absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1020" y="800" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="camera-state" value="Camera stream state&lt;br&gt;Pooled hidden decoder&lt;br&gt;Clamped ON/OFF toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="audio-state" value="Audio stream state&lt;br&gt;Pooled hidden decoder&lt;br&gt;Clamped ON/OFF toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1370" y="650" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="coupling-note" value="Optional cross-modal loop&lt;br&gt;Each hidden field predicts the other&lt;br&gt;Separate learned coupling matrices" style="text;whiteSpace=wrap;html=1;fontSize=16;align=center;" vertex="1" parent="1"><mxGeometry x="590" y="610" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="notes" value="Shared channel weights are learned across pixels; there is no dense all-pixel predictive matrix. Both hidden branches contribute to the same canvas update.&#xa;Source ON/OFF evidence is distinct from missing samples. Preserve pre-evidence predictions for the UI. No additional canvas-minus-prior restoring force.&#xa;New inter-region edges must name their operator: spatial conductance, predictive coupling, or another explicit rule. Arbitrary edges are not part of the first shader port." style="text;whiteSpace=wrap;html=1;fontSize=17;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1490" height="90" as="geometry"/></mxCell>
        <mxCell id="e-substrate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="substrate" target="prior" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-prior" value="initialize, not restore" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="prior" target="canvas" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-canvas-visual" value="visual canvas weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=15;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" source="canvas" target="visual-hidden" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-canvas-audio" value="audio canvas weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=15;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" source="canvas" target="audio-hidden" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-visual-camera" value="camera decoder weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="visual-hidden" target="camera" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-audio-pool" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="audio-hidden" target="pool" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-pool-audio" value="audio decoder weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="pool" target="audio" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-coupling" value="optional" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;dashed=1;fontSize=14;" edge="1" source="visual-hidden" target="audio-hidden" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-visual-state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="visual-hidden" target="camera-state" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-audio-state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="audio-hidden" target="audio-state" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

          </mxGeometry>
        </mxCell>
        <mxCell id="validate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;" value="5 | Final errors + finite validation&lt;br&gt;&lt;br&gt;Validate settled state before learning&lt;br&gt;Reduce validity to a small host flag&lt;br&gt;Explicit divergence errors, no silent fallback" vertex="1">
          <mxGeometry height="140" width="440" x="40" y="700" as="geometry" />
        </mxCell>
        <mxCell id="learn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="6 | Optional learning, once per frame&lt;br&gt;&lt;br&gt;Reduce local weight gradients&lt;br&gt;Camera / audio / state / coupling weights&lt;br&gt;Preserve averaging, decay and clipping rules" vertex="1">
          <mxGeometry height="140" width="440" x="560" y="700" as="geometry" />
        </mxCell>
        <mxCell id="correct" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="7 | Commit net sensory correction&lt;br&gt;&lt;br&gt;delta = settled canvas - wave prior&lt;br&gt;wave_current += delta&lt;br&gt;wave_old += delta&lt;br&gt;Preserve wave velocity" vertex="1">
          <mxGeometry height="140" width="440" x="1100" y="700" as="geometry" />
        </mxCell>
        <mxCell id="present" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="8 | Direct RGB texture presentation&lt;br&gt;&lt;br&gt;Corrected canvas, not camera prediction&lt;br&gt;Display mapping in fragment shader&lt;br&gt;No full-frame CPU download" vertex="1">
          <mxGeometry height="130" width="440" x="1100" y="920" as="geometry" />
        </mxCell>
        <mxCell id="preview" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="9 | Optional bounded snapshots&lt;br&gt;&lt;br&gt;Frozen pre-evidence predictions + targets&lt;br&gt;512 / 64 max side at 10 Hz&lt;br&gt;Clear missing evidence and stale views" vertex="1">
          <mxGeometry height="130" width="440" x="560" y="920" as="geometry" />
        </mxCell>
        <mxCell id="next" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" value="Next frame&lt;br&gt;&lt;br&gt;Retain learned weights and hidden state&lt;br&gt;Apply validated config / future topology edits&lt;br&gt;Reset clears state, retains weights" vertex="1">
          <mxGeometry height="130" width="440" x="40" y="920" as="geometry" />
        </mxCell>
        <mxCell id="milestones" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=17;align=left;" value="IMPLEMENTATION GATES: A. RGB native state + context lifecycle | B. Camera inference parity | C. Audio + stream state + coupling + learning | D. UI previews + 1080p profiling&#xa;Sparse / hemispheric topology is a separate follow-on. Fuse passes only after parity; do not remove required reduction or synchronous-update boundaries." vertex="1">

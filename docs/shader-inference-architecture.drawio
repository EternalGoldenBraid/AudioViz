  <diagram id="shader-phases" name="2 - Frame phases and milestones">
    <mxGraphModel dx="2416" dy="1536" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=26;fontStyle=1;align=left;whiteSpace=wrap;" value="Shader inference | Exact frame phases before performance tuning" vertex="1">
          <mxGeometry height="50" width="1510" x="30" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=16;align=left;whiteSpace=wrap;" value="One owning GL context / thread. Arrows imply dispatch ordering and the appropriate memory barrier, not CPU readback." vertex="1">
          <mxGeometry height="40" width="1510" x="30" y="85" as="geometry" />
        </mxCell>
        <mxCell id="wave" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="1 | Propagate + preserve prior&lt;br&gt;&lt;br&gt;RGB wave dynamics, current/old buffers&lt;br&gt;Copy native prior for net correction&lt;br&gt;Apply pending config at frame boundary" vertex="1">
          <mxGeometry height="115" width="440" x="40" y="170" as="geometry" />
        </mxCell>
        <mxCell id="predict" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="2 | Predict BEFORE fresh evidence&lt;br&gt;&lt;br&gt;Advance persistent hidden belief&lt;br&gt;Save camera + audio expectations&lt;br&gt;Do not replace these with final reconstructions" vertex="1">
          <mxGeometry height="115" width="440" x="40" y="330" as="geometry" />
        </mxCell>
        <mxCell id="evidence" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;" value="3 | Acquire / upload / clamp&lt;br&gt;&lt;br&gt;GPU camera normalization + RGB + resize&lt;br&gt;Audio bands + explicit source ON/OFF&lt;br&gt;Missing samples remain unclamped" vertex="1">
          <mxGeometry height="115" width="440" x="40" y="490" as="geometry" />
        </mxCell>
        <mxCell id="loop" parent="1" style="swimlane;html=1;startSize=45;fillColor=#f7faff;strokeColor=#6c8ebf;fontSize=18;fontStyle=1;" value="4 | Repeat configured settling steps | Same weight version throughout" vertex="1">
          <mxGeometry height="435" width="980" x="560" y="170" as="geometry" />
        </mxCell>
        <mxCell id="reduce" parent="loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="4a | Activations + pooled reductions&lt;br&gt;Audio spatial mean; stream-state logits&lt;br&gt;Partial sums then final reduction" vertex="1">
          <mxGeometry height="105" width="400" x="30" y="90" as="geometry" />
        </mxCell>
        <mxCell id="errors" parent="loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="4b | Predictions + errors&lt;br&gt;Canvas / camera / audio / optional coupling&lt;br&gt;Read the SAME old canvas + hidden states" vertex="1">
          <mxGeometry height="105" width="400" x="550" y="90" as="geometry" />
        </mxCell>
        <mxCell id="directions" parent="loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="4c | Compute all directions&lt;br&gt;Sum branch contributions to canvas&lt;br&gt;Write scratch; do NOT mutate old states" vertex="1">
          <mxGeometry height="105" width="400" x="550" y="270" as="geometry" />
        </mxCell>
        <mxCell id="advance" parent="loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;" value="4d | Advance together + swap buffers&lt;br&gt;Apply canvas + both hidden updates&lt;br&gt;Make writes visible before next iteration" vertex="1">
          <mxGeometry height="105" width="400" x="30" y="270" as="geometry" />
        </mxCell>
        <mxCell id="e-reduce-errors" edge="1" parent="loop" source="reduce" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="errors">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-errors-directions" edge="1" parent="loop" source="errors" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="directions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-directions-advance" edge="1" parent="loop" source="directions" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" target="advance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-repeat" edge="1" parent="loop" source="advance" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;fontSize=14;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" target="reduce" value="next step">

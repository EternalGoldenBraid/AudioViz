  </diagram>
  <diagram id="shader-model" name="3 - Predictive model graph">
    <mxGraphModel dx="1560" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Predictive model | Existing equations, proposed OpenGL execution" style="text;html=1;fontSize=26;fontStyle=1;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Solid arrows: generative prediction pathways. Inference carries errors back through these pathways; it is not camera-to-canvas injection." style="text;html=1;fontSize=16;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="substrate" value="Spatial dynamics: separate operator&lt;br&gt;&lt;br&gt;Wave neighbors + fixed conductances&lt;br&gt;Propagate each RGB canvas channel&lt;br&gt;Not learned camera/audio weights" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="390" height="130" as="geometry" />
        </mxCell>
        <mxCell id="prior" value="RGB wave prior&lt;br&gt;Initial canvas for this settling frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="610" y="160" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="canvas" value="Shared canvas c&lt;br&gt;Rows x columns x 3&lt;br&gt;tanh(c) feeds both hidden branches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="visual-hidden" value="Persistent visual hidden field&lt;br&gt;Rows x columns x hidden channels&lt;br&gt;6 channels by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="200" y="500" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="audio-hidden" value="Persistent audio hidden field&lt;br&gt;Rows x columns x hidden channels&lt;br&gt;6 channels by default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="1020" y="500" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="camera" value="Camera RGB prediction / target&lt;br&gt;Per-pixel decoder of tanh(h_visual)&lt;br&gt;Target unclamped when sample absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="200" y="800" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="Spatial mean of tanh(h_audio)&lt;br&gt;One shared spectral prediction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="1020" y="650" width="330" height="80" as="geometry" />
        </mxCell>
        <mxCell id="audio" value="Audio spectrum prediction / target&lt;br&gt;Spectral-band decoder of pooled activity&lt;br&gt;Target unclamped when sample absent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;" vertex="1" parent="1">
          <mxGeometry x="1020" y="800" width="330" height="100" as="geometry" />
        </mxCell>
        <mxCell id="camera-state" value="Camera stream state&lt;br&gt;Pooled hidden decoder&lt;br&gt;Clamped ON/OFF toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="audio-state" value="Audio stream state&lt;br&gt;Pooled hidden decoder&lt;br&gt;Clamped ON/OFF toggle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1370" y="650" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="coupling-note" value="Optional cross-modal loop&lt;br&gt;Each hidden field predicts the other&lt;br&gt;Separate learned coupling matrices" style="text;whiteSpace=wrap;html=1;fontSize=16;align=center;" vertex="1" parent="1">
          <mxGeometry x="590" y="610" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="Shared channel weights are learned across pixels; there is no dense all-pixel predictive matrix. Both hidden branches contribute to the same canvas update.&#xa;Source ON/OFF evidence is distinct from missing samples. Preserve pre-evidence predictions for the UI. No additional canvas-minus-prior restoring force.&#xa;New inter-region edges must name their operator: spatial conductance, predictive coupling, or another explicit rule. Arbitrary edges are not part of the first shader port." style="text;whiteSpace=wrap;html=1;fontSize=17;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="1490" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e-substrate" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="substrate" target="prior" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-prior" value="initialize, not restore" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="prior" target="canvas" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-canvas-visual" value="visual canvas weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=15;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" source="canvas" target="visual-hidden" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-canvas-audio" value="audio canvas weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=15;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" source="canvas" target="audio-hidden" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-visual-camera" value="camera decoder weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="visual-hidden" target="camera" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-audio-pool" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" source="audio-hidden" target="pool" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pool-audio" value="audio decoder weights" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;fontSize=14;" edge="1" source="pool" target="audio" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-coupling" value="optional" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;startArrow=block;dashed=1;fontSize=14;" edge="1" source="visual-hidden" target="audio-hidden" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-visual-state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="visual-hidden" target="camera-state" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-audio-state" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="audio-hidden" target="audio-state" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

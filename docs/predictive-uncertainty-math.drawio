<mxfile host="Electron" modified="2026-10-19T12:18:34Z" version="26.0.0">
  <diagram id="uncertainty-terms" name="1 - Terms and distributions">
    <mxGraphModel dx="1440" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="terms-title" value="1 / TERMS — What is uncertain, and what is observed?" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="terms-intro" value="Uncoupled visual pathway, per pixel r. K hidden channels; 3 sensory channels. Conditions: history D (observations and gaze actions), known point canvas c, fixed weights W." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="terms-input" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1" value="&lt;b&gt;Known inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;c: wave-canvas point estimate&lt;br&gt;W&lt;sub&gt;c&lt;/sub&gt;: canvas → hidden weights&lt;br&gt;W&lt;sub&gt;v&lt;/sub&gt;: hidden → RGB weights&lt;br&gt;&lt;br&gt;Their uncertainty is not propagated.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1&quot;&gt;predictive_coding.py:139&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-hidden" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:21:1" value="&lt;b&gt;Hidden belief&lt;/b&gt;&lt;br&gt;&lt;br&gt;h ∈ R&lt;sup&gt;K&lt;/sup&gt;: uncertain hidden state&lt;br&gt;m ∈ R&lt;sup&gt;K&lt;/sup&gt;: existing PC point estimate&lt;br&gt;q(h) = N(m, P)&lt;br&gt;v = diag(P): stored K-vector&lt;br&gt;P = Diag(v): conceptual K × K matrix&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:21:1&quot;&gt;gaussian_uncertainty.py:21&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="430" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-sensory" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:101:1" value="&lt;b&gt;Predictive sensory belief&lt;/b&gt;&lt;br&gt;&lt;br&gt;X = g(h) = W&lt;sub&gt;v&lt;/sub&gt; tanh(h): clean RGB state&lt;br&gt;μ = g(m): rendered image estimate&lt;br&gt;J = W&lt;sub&gt;v&lt;/sub&gt; Diag(1 − tanh(m)&lt;sup&gt;2&lt;/sup&gt;), 3 × K&lt;br&gt;V = J P J&lt;sup&gt;T&lt;/sup&gt;, 3 × 3&lt;br&gt;q(X) ≈ N(μ, V): local linearization&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:101:1&quot;&gt;gaussian_uncertainty.py:101&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="890" y="170" width="470" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-identity" value="&lt;b&gt;Deterministic pixels ≠ R = I&lt;sub&gt;3&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;A deterministic frame is a noiseless scene realization, not R = I&lt;sub&gt;3&lt;/sub&gt; (zero noise would mean degenerate R → 0).&lt;br&gt;&lt;br&gt;R = I&lt;sub&gt;3&lt;/sub&gt; only when model precision is unit (λ = 1, Full canvas). Neither P&lt;sub&gt;0&lt;/sub&gt; = I&lt;sub&gt;K&lt;/sub&gt; nor R = I&lt;sub&gt;3&lt;/sub&gt; implies V = I&lt;sub&gt;3&lt;/sub&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-action" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Gaze mode sets measurement precision&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Mouse / Autonomous:&lt;/b&gt; a ∈ [0,1]&lt;sup&gt;2&lt;/sup&gt; sets Gaussian λ&lt;sub&gt;a&lt;/sub&gt;(r), R&lt;sub&gt;a&lt;/sub&gt;(r) = λ&lt;sub&gt;a&lt;/sub&gt;(r)&lt;sup&gt;−1&lt;/sup&gt; I&lt;sub&gt;3&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; uniform λ(r) = 1 ⇒ R(r) = I&lt;sub&gt;3&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Observe off:&lt;/b&gt; λ(r) = 0 (unobserved; do not invert)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;spatial_precision.py:46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="530" width="430" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-observation" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:60:1" value="&lt;b&gt;Noisy observation / likelihood&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y&lt;sub&gt;a&lt;/sub&gt; = X + ε&lt;sub&gt;a&lt;/sub&gt;; ε&lt;sub&gt;a&lt;/sub&gt; ~ N(0, R&lt;sub&gt;a&lt;/sub&gt;)&lt;br&gt;Noise is independent of X.&lt;br&gt;p(Y&lt;sub&gt;a&lt;/sub&gt; | h, a) = N(g(h), R&lt;sub&gt;a&lt;/sub&gt;)&lt;br&gt;Predicted measurement covariance: S = V + R&lt;sub&gt;a&lt;/sub&gt;&lt;br&gt;Information target: X, not fresh sensor noise ε.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:60:1&quot;&gt;spatial_precision.py:60 (likelihood)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="890" y="530" width="470" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-approx" value="&lt;b&gt;Interpretation boundary&lt;/b&gt;  μ = g(m) approximates E[X]; nonlinear decoding does not preserve means exactly. The PC solver supplies m; a separate local Gaussian filter supplies P. This is not an exact joint posterior or the variance of diagnostic error energy.&lt;br&gt;R is an assigned likelihood-noise model; camera intrinsics describe geometry, not R. The synthetic frames do not inject this assumed sensor noise.&lt;br&gt;&lt;br&gt;Blue = model belief. Purple = measurement model. Code labels open this checkout in VS Code; see the documentation for portable source paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="terms-input-hidden" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-input" target="terms-hidden" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-hidden-sensory" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-hidden" target="terms-sensory" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-sensory-observation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="terms-sensory" target="terms-observation" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-action-observation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-action" target="terms-observation" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-filter" name="2 - Forecast and conditioning">
    <mxGraphModel dx="1440" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1060" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="filter-title" value="2 / FILTER — Forecast first; condition once on the new observation" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-intro" value="Superscript − = before the new evidence; + = after it. α = inference_rate, Δt = 1 / stimulus FPS, q = configured process variance rate. Equations are per pixel." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-mean" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1" value="&lt;b&gt;1. Predict the existing mean&lt;/b&gt;&lt;br&gt;&lt;br&gt;m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = (1 − α)m&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt;&lt;br&gt;                 + α W&lt;sub&gt;c&lt;/sub&gt; tanh(c&lt;sub&gt;t+1&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;μ&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = W&lt;sub&gt;v&lt;/sub&gt; tanh(m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;The wave canvas is a known forcing input.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1&quot;&gt;predictive_coding.py:139&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-cov" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:78:1" value="&lt;b&gt;2. Predict hidden covariance&lt;/b&gt;&lt;br&gt;&lt;br&gt;F = ∂m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; / ∂m&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = (1 − α) I&lt;sub&gt;K&lt;/sub&gt;&lt;br&gt;P&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = F P&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; F&lt;sup&gt;T&lt;/sup&gt; + q Δt I&lt;sub&gt;K&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Stored vector:&lt;br&gt;v&lt;sup&gt;−&lt;/sup&gt; = (1 − α)&lt;sup&gt;2&lt;/sup&gt; v&lt;sup&gt;+&lt;/sup&gt; + q Δt&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:78:1&quot;&gt;gaussian_uncertainty.py:78&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-freeze" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:101:1" value="&lt;b&gt;3. Freeze the linearization&lt;/b&gt;&lt;br&gt;&lt;br&gt;Capture m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; before inference settles.&lt;br&gt;J = W&lt;sub&gt;v&lt;/sub&gt; Diag(1 − tanh(m&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;V&lt;sup&gt;−&lt;/sup&gt; = J P&lt;sup&gt;−&lt;/sup&gt; J&lt;sup&gt;T&lt;/sup&gt;&lt;br&gt;&lt;br&gt;Keep all 3 × 3 RGB covariance entries.&lt;br&gt;Do not recompute J from corrected means.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:101:1&quot;&gt;gaussian_uncertainty.py:101&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-glsl" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/opengl_predictive.py:271:1" value="&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/opengl_predictive.py:271:1&quot;&gt;Same mean transition in GLSL: opengl_predictive.py:271&lt;/a&gt;" style="text;whiteSpace=wrap;html=1;fontSize=14;align=left;fontColor=#1e5a90;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="filter-evidence" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Actual observation precision&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Spatial (Mouse / Autonomous):&lt;/b&gt;&lt;br&gt;  λ&lt;sub&gt;a&lt;/sub&gt;(r) = β + ρ exp(−‖r − r&lt;sub&gt;a&lt;/sub&gt;‖&lt;sup&gt;2&lt;/sup&gt; / (2s&lt;sup&gt;2&lt;/sup&gt;))&lt;br&gt;  s = sigma · min(rows, cols); a ∈ [0,1]&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; λ(r) = 1 everywhere (R = I&lt;sub&gt;3&lt;/sub&gt;)&lt;br&gt;• &lt;b&gt;Observe off / missing (λ = 0):&lt;/b&gt; P&lt;sup&gt;+&lt;/sup&gt; = P&lt;sup&gt;−&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;spatial_precision.py:46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="filter-condition" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:111:1" value="&lt;b&gt;4. Condition, then retain only the hidden diagonal&lt;/b&gt;&lt;br&gt;&lt;br&gt;M = I&lt;sub&gt;3&lt;/sub&gt; + λ V&lt;sup&gt;−&lt;/sup&gt;&lt;br&gt;C = P&lt;sup&gt;−&lt;/sup&gt; − λ P&lt;sup&gt;−&lt;/sup&gt; J&lt;sup&gt;T&lt;/sup&gt; M&lt;sup&gt;−1&lt;/sup&gt; J P&lt;sup&gt;−&lt;/sup&gt;  (full local posterior covariance)&lt;br&gt;v&lt;sup&gt;+&lt;/sup&gt; = diag(C); P&lt;sup&gt;+&lt;/sup&gt; = Diag(v&lt;sup&gt;+&lt;/sup&gt;)  (stored approximation)&lt;br&gt;&lt;br&gt;Mean m&lt;sup&gt;+&lt;/sup&gt; comes from the existing PC solver, not a Kalman-mean update here.&lt;br&gt;One covariance update per observation; zero extra updates during settling.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:111:1&quot;&gt;gaussian_uncertainty.py:111 — NumPy / CuPy and GLSL&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="860" height="250" as="geometry"/></mxCell>
        <mxCell id="filter-lifecycle" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:175:1" value="&lt;b&gt;Lifecycle wiring&lt;/b&gt;&lt;br&gt;predict_visual(): optional gaze policy → mean → covariance forecast/freeze.&lt;br&gt;correct_from_observations(): PC correction → covariance condition.&lt;br&gt;Covariance still predicts if camera evidence is missing.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:175:1&quot;&gt;orchestrator.py:175 (forecast/gaze); conditioning at line 242&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="640" height="150" as="geometry"/></mxCell>
        <mxCell id="filter-reference" link="vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_gaussian_uncertainty.py:47:1" value="&lt;b&gt;Limits and mathematical reference&lt;/b&gt;&lt;br&gt;q is configured hidden-state variance / second, not residual-energy variance. For |1 − α| &amp;lt; 1, covariance can contract without observing.&lt;br&gt;Hidden correlations created in C are dropped before the next forecast.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_gaussian_uncertainty.py:47:1&quot;&gt;Dense-matrix reference: test_gaussian_uncertainty.py:47&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="890" width="620" height="150" as="geometry"/></mxCell>
        <mxCell id="filter-mean-cov" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-mean" target="filter-cov" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-cov-freeze" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-cov" target="filter-freeze" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-freeze-condition" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.76744;entryY=0;" edge="1" source="filter-freeze" target="filter-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-evidence-condition" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-evidence" target="filter-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-memory" value="next frame: P+" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=1;fontSize=14;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="filter-condition" target="filter-cov" parent="1">
          <mxGeometry relative="1" x="0.5" y="-15" as="geometry"><Array as="points"><mxPoint x="1400" y="685"/><mxPoint x="1400" y="150"/><mxPoint x="700" y="150"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-objective" name="3 - Sensory information objective">
    <mxGraphModel dx="1440" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="objective-title" value="3 / OBJECTIVE — Where would observing reduce sensory uncertainty?" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="objective-intro" value="With the scene prior fixed across gaze actions, maximizing IG minimizes expected remaining sensory uncertainty. The target is X, not sensor noise or diagnostic residual energy." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="50" as="geometry"/></mxCell>
        <mxCell id="objective-definition" value="&lt;b&gt;Expected information gain = conditional mutual information&lt;/b&gt;&lt;br&gt;&lt;br&gt;IG(a) = I(X&lt;sub&gt;t+1&lt;/sub&gt;; Y&lt;sub&gt;a&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;, c, W) = E&lt;sub&gt;Yₐ&lt;/sub&gt; [ KL(q(X&lt;sub&gt;t+1&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;, Y&lt;sub&gt;a&lt;/sub&gt;, a) ‖ q(X&lt;sub&gt;t+1&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;)) ]&lt;br&gt;The c, W conditions are suppressed on the right. Gaussian q is the local approximation; the expectation is evaluated analytically, before seeing Y&lt;sub&gt;a&lt;/sub&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1320" height="150" as="geometry"/></mxCell>
        <mxCell id="objective-forecast" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1" value="&lt;b&gt;Forecast the next sensory covariance&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start from the current corrected hidden mean and P&lt;sup&gt;+&lt;/sup&gt;.&lt;br&gt;Apply the same prediction transition and decoder Jacobian.&lt;br&gt;Planning holds c&lt;sub&gt;t+1&lt;/sub&gt; ≈ c&lt;sub&gt;t&lt;/sub&gt; fixed for this one step.&lt;br&gt;V&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = J&lt;sub&gt;r&lt;/sub&gt; P&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; J&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt;: full local RGB covariance&lt;br&gt;&lt;br&gt;No future wave rollout or unseen camera region is modeled.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1&quot;&gt;expected_information_gain():179 — forecast / RGB projection&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="620" height="240" as="geometry"/></mxCell>
        <mxCell id="objective-action" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Evaluate a hypothetical observation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each candidate a supplies a different spatial field λ&lt;sub&gt;a&lt;/sub&gt;(r).&lt;br&gt;Assume Y&lt;sub&gt;a,r&lt;/sub&gt; = X&lt;sub&gt;r&lt;/sub&gt; + ε&lt;sub&gt;a,r&lt;/sub&gt;, R&lt;sub&gt;a,r&lt;/sub&gt; = λ&lt;sub&gt;a&lt;/sub&gt;(r)&lt;sup&gt;−1&lt;/sup&gt; I&lt;sub&gt;3&lt;/sub&gt;.&lt;br&gt;Independent pixels are summed; RGB correlations remain.&lt;br&gt;Zero precision contributes zero information.&lt;br&gt;&lt;br&gt;No actual future sample or evaluator truth is needed to score a.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;GaussianSpatialPrecision.field():46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="390" width="620" height="240" as="geometry"/></mxCell>
        <mxCell id="objective-gain" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1" value="&lt;b&gt;Sensory information gain — natural logarithms, measured in nats&lt;/b&gt;&lt;br&gt;&lt;br&gt;IG(a) = ½ Σ&lt;sub&gt;r&lt;/sub&gt; ln det(I&lt;sub&gt;3&lt;/sub&gt; + λ&lt;sub&gt;a&lt;/sub&gt;(r) V&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;t&lt;sub&gt;1&lt;/sub&gt; = tr(V); t&lt;sub&gt;2&lt;/sub&gt; = Σ&lt;sub&gt;i&amp;lt;j&lt;/sub&gt;(V&lt;sub&gt;ii&lt;/sub&gt; V&lt;sub&gt;jj&lt;/sub&gt; − V&lt;sub&gt;ij&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;); t&lt;sub&gt;3&lt;/sub&gt; = det(V)&lt;br&gt;Implemented quadrature: IĜ(a) = ½ Σ&lt;sub&gt;sampled r&lt;/sub&gt; w&lt;sub&gt;r&lt;/sub&gt; log1p(λ t&lt;sub&gt;1&lt;/sub&gt; + λ&lt;sup&gt;2&lt;/sup&gt; t&lt;sub&gt;2&lt;/sub&gt; + λ&lt;sup&gt;3&lt;/sup&gt; t&lt;sub&gt;3&lt;/sub&gt;)&lt;br&gt;w&lt;sub&gt;r&lt;/sub&gt; = w&lt;sub&gt;row&lt;/sub&gt; w&lt;sub&gt;col&lt;/sub&gt; pixel-area cell weights over [−½, R−½] × [−½, C−½] (Σ w&lt;sub&gt;r&lt;/sub&gt; = N). Valid for PSD V, including rank-deficient cases.&lt;br&gt;IG uses full local Gaussian conditioning, before the hidden-diagonal projection; it is not the entropy drop of the stored diagonal alone.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1&quot;&gt;gaussian_uncertainty.py:179 — CPU/CuPy scoring, GLSL moments/reduction, _pixel_area_weights:293&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1320" height="250" as="geometry"/></mxCell>
        <mxCell id="objective-ui" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/gaze.py:10:1" value="&lt;b&gt;Gaze modes &amp;amp; evaluation metrics&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Mouse (default):&lt;/b&gt; manual gaze; IĜ overlay is advisory.&lt;br&gt;• &lt;b&gt;Autonomous (synthetic demo):&lt;/b&gt; greedy argmax&lt;sub&gt;a&lt;/sub&gt; IĜ(a) per model step; holds gaze on tie/zero gain; no truth leakage.&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; uniform λ = 1 (not Observe off).&lt;br&gt;• &lt;b&gt;Metrics:&lt;/b&gt; ideal IĜ ≠ diagonal v&lt;sup&gt;+&lt;/sup&gt; ≠ next-frame image error.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/gaze.py:10:1&quot;&gt;gaze.py:10 (selector); active_vision_experiment.py:252; active_vision.py:75&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="640" height="180" as="geometry"/></mxCell>
        <mxCell id="objective-bounds" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1" value="&lt;b&gt;Bounded, approximate execution&lt;/b&gt;&lt;br&gt;9 × 13 candidate grid; pixel-area quadrature (max side 64).&lt;br&gt;Native backend covariance; OpenGL downloads 117 scores.&lt;br&gt;Preview overlay ≤ 10 Hz; autonomous mode steps at frame clock.&lt;br&gt;Narrow footprints may be missed by coarse spatial sampling.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:179:1&quot;&gt;gaussian_uncertainty.py:179 / _pixel_area_weights:293&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="1010" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="objective-forecast-gain" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.23485;entryY=0;" edge="1" source="objective-forecast" target="objective-gain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="objective-action-gain" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.76515;entryY=0;" edge="1" source="objective-action" target="objective-gain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="objective-gain-ui" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.24242;exitY=1;entryX=0.5;entryY=0;" edge="1" source="objective-gain" target="objective-ui" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

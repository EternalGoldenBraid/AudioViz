<mxfile host="Electron" modified="2026-10-19T12:18:34Z" version="26.0.0">
  <diagram id="uncertainty-terms" name="1 - Terms and distributions">
    <mxGraphModel dx="1440" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="980" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="terms-title" value="1 / TERMS — What is uncertain, and what is observed?" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="terms-intro" value="Uncoupled visual pathway, per pixel r. K hidden channels; 3 sensory channels. Conditions: history D (observations and gaze actions), known point canvas c, fixed weights W." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="terms-input" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1" value="&lt;b&gt;Known inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;c: wave-canvas point estimate&lt;br&gt;W&lt;sub&gt;c&lt;/sub&gt;: canvas → hidden weights&lt;br&gt;W&lt;sub&gt;v&lt;/sub&gt;: hidden → RGB weights&lt;br&gt;&lt;br&gt;Their uncertainty is not propagated.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/predictive_coding.py:139:1&quot;&gt;predictive_coding.py:139&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-hidden" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:33:1" value="&lt;b&gt;Hidden belief&lt;/b&gt;&lt;br&gt;&lt;br&gt;h ∈ R&lt;sup&gt;K&lt;/sup&gt;: uncertain hidden state&lt;br&gt;m ∈ R&lt;sup&gt;K&lt;/sup&gt;: temporal Gaussian hidden mean&lt;br&gt;q(h) = N(m, P)&lt;br&gt;v = diag(P): stored K-vector&lt;br&gt;P = Diag(v): conceptual K × K matrix&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:33:1&quot;&gt;gaussian_uncertainty.py:33&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="170" width="430" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-sensory" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:151:1" value="&lt;b&gt;Predictive sensory belief&lt;/b&gt;&lt;br&gt;&lt;br&gt;X = g(h) = W&lt;sub&gt;v&lt;/sub&gt; tanh(h): clean RGB state&lt;br&gt;μ = g(m): rendered image estimate&lt;br&gt;J = W&lt;sub&gt;v&lt;/sub&gt; Diag(1 − tanh(m)&lt;sup&gt;2&lt;/sup&gt;), 3 × K&lt;br&gt;V = J P J&lt;sup&gt;T&lt;/sup&gt;, 3 × 3&lt;br&gt;q(X) ≈ N(μ, V): local linearization&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:151:1&quot;&gt;gaussian_uncertainty.py:151&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="890" y="170" width="470" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-identity" value="&lt;b&gt;Deterministic pixels ≠ R = I&lt;sub&gt;3&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;A deterministic frame is a noiseless scene realization, not R = I&lt;sub&gt;3&lt;/sub&gt; (zero noise would mean degenerate R → 0).&lt;br&gt;&lt;br&gt;R = I&lt;sub&gt;3&lt;/sub&gt; only when model precision is unit (λ = 1, Full canvas). Neither P&lt;sub&gt;0&lt;/sub&gt; = I&lt;sub&gt;K&lt;/sub&gt; nor R = I&lt;sub&gt;3&lt;/sub&gt; implies V = I&lt;sub&gt;3&lt;/sub&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="300" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-action" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Gaze mode sets measurement precision&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Mouse / Autonomous:&lt;/b&gt; a ∈ [0,1]&lt;sup&gt;2&lt;/sup&gt; sets Gaussian λ&lt;sub&gt;a&lt;/sub&gt;(r), R&lt;sub&gt;a&lt;/sub&gt;(r) = λ&lt;sub&gt;a&lt;/sub&gt;(r)&lt;sup&gt;−1&lt;/sup&gt; I&lt;sub&gt;3&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; uniform λ(r) = 1 ⇒ R(r) = I&lt;sub&gt;3&lt;/sub&gt;&lt;br&gt;• &lt;b&gt;Observe off:&lt;/b&gt; λ(r) = 0 (unobserved; do not invert)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;spatial_precision.py:46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="400" y="530" width="430" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-observation" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:60:1" value="&lt;b&gt;Noisy observation / likelihood&lt;/b&gt;&lt;br&gt;&lt;br&gt;Y&lt;sub&gt;a&lt;/sub&gt; = X + ε&lt;sub&gt;a&lt;/sub&gt;; ε&lt;sub&gt;a&lt;/sub&gt; ~ N(0, R&lt;sub&gt;a&lt;/sub&gt;)&lt;br&gt;Noise is independent of X.&lt;br&gt;p(Y&lt;sub&gt;a&lt;/sub&gt; | h, a) = N(g(h), R&lt;sub&gt;a&lt;/sub&gt;)&lt;br&gt;Predicted measurement covariance: S = V + R&lt;sub&gt;a&lt;/sub&gt;&lt;br&gt;Information target: X, not fresh sensor noise ε.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:60:1&quot;&gt;spatial_precision.py:60 (likelihood)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="890" y="530" width="470" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="terms-approx" value="&lt;b&gt;Interpretation boundary&lt;/b&gt;  μ = g(m) approximates E[X]; nonlinear decoding does not preserve means exactly. Opt-in temporal Gaussian mode updates (m, P) jointly via one frozen-affine EKF step (ordinary PC mode keeps multi-step settling when disabled). Not a joint wave posterior or residual-energy variance.&lt;br&gt;R is an assigned likelihood-noise model; camera intrinsics describe geometry, not R. The synthetic frames do not inject this assumed sensor noise.&lt;br&gt;&lt;br&gt;Blue = model belief. Purple = measurement model. Code labels open this checkout in VS Code; see the documentation for portable source paths." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1320" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="terms-input-hidden" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-input" target="terms-hidden" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-hidden-sensory" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-hidden" target="terms-sensory" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-sensory-observation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="terms-sensory" target="terms-observation" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terms-action-observation" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="terms-action" target="terms-observation" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-filter" name="2 - Forecast and conditioning">
    <mxGraphModel dx="1440" dy="1060" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1060" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="filter-title" value="2 / FILTER — Forecast first; condition once on the new observation" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-intro" value="Superscript − = before new evidence; + = after it. τ = memory_time_constant (default 1/3 s, independent of PC inference_rate), Δt = 1 / stimulus FPS (live main: monotonic elapsed s), D = process_variance. Equations are per pixel." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="filter-mean" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:108:1" value="&lt;b&gt;1. Predict the hidden mean (exact OU)&lt;/b&gt;&lt;br&gt;&lt;br&gt;ρ = exp(−Δt / τ)&lt;br&gt;m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = ρ m&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; + (1 − ρ) W&lt;sub&gt;c&lt;/sub&gt; tanh(c&lt;sub&gt;t+1&lt;/sub&gt;)&lt;br&gt;&lt;br&gt;μ&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = W&lt;sub&gt;v&lt;/sub&gt; tanh(m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;The wave canvas is a known forcing input.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:108:1&quot;&gt;gaussian_uncertainty.py:108&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-cov" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:77:1" value="&lt;b&gt;2. Predict hidden covariance&lt;/b&gt;&lt;br&gt;&lt;br&gt;F = ∂m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; / ∂m&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = ρ I&lt;sub&gt;K&lt;/sub&gt;&lt;br&gt;Q(Δt) = ½ D τ (1 − ρ&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;&lt;br&gt;Stored vector:&lt;br&gt;v&lt;sup&gt;−&lt;/sup&gt; = ρ&lt;sup&gt;2&lt;/sup&gt; v&lt;sup&gt;+&lt;/sup&gt; + Q(Δt)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:77:1&quot;&gt;_transition():77 / predict():108&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-freeze" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:151:1" value="&lt;b&gt;3. Freeze the linearization&lt;/b&gt;&lt;br&gt;&lt;br&gt;Freeze m&lt;sub&gt;t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; before conditioning.&lt;br&gt;J = W&lt;sub&gt;v&lt;/sub&gt; Diag(1 − tanh(m&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;V&lt;sup&gt;−&lt;/sup&gt; = J P&lt;sup&gt;−&lt;/sup&gt; J&lt;sup&gt;T&lt;/sup&gt;&lt;br&gt;&lt;br&gt;Keep all 3 × 3 RGB covariance entries.&lt;br&gt;Do not recompute J from corrected means.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:151:1&quot;&gt;gaussian_uncertainty.py:151&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="400" height="240" as="geometry"/></mxCell>
        <mxCell id="filter-glsl" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:129:1" value="&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:129:1&quot;&gt;Same OU mean/covariance forecast in GLSL: gaussian_uncertainty.py:129&lt;/a&gt;" style="text;whiteSpace=wrap;html=1;fontSize=14;align=left;fontColor=#1e5a90;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="400" height="50" as="geometry"/></mxCell>
        <mxCell id="filter-evidence" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Actual observation precision&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Spatial (Mouse / Autonomous):&lt;/b&gt;&lt;br&gt;  λ&lt;sub&gt;a&lt;/sub&gt;(r) = β + ρ&lt;sub&gt;0&lt;/sub&gt; exp(−‖r − r&lt;sub&gt;a&lt;/sub&gt;‖&lt;sup&gt;2&lt;/sup&gt; / (2s&lt;sup&gt;2&lt;/sup&gt;))&lt;br&gt;  s = sigma · min(rows, cols); a ∈ [0,1]&lt;sup&gt;2&lt;/sup&gt;&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; λ(r) = 1 everywhere (R = I&lt;sub&gt;3&lt;/sub&gt;)&lt;br&gt;• &lt;b&gt;Observe off / missing (λ = 0):&lt;/b&gt; m&lt;sup&gt;+&lt;/sup&gt; = m&lt;sup&gt;−&lt;/sup&gt;, P&lt;sup&gt;+&lt;/sup&gt; = P&lt;sup&gt;−&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;spatial_precision.py:46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="filter-condition" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:161:1" value="&lt;b&gt;4. Condition mean and covariance jointly; retain hidden diagonal&lt;/b&gt;&lt;br&gt;&lt;br&gt;M = I&lt;sub&gt;3&lt;/sub&gt; + λ V&lt;sup&gt;−&lt;/sup&gt;;  Δm = λ P&lt;sup&gt;−&lt;/sup&gt; J&lt;sup&gt;T&lt;/sup&gt; M&lt;sup&gt;−1&lt;/sup&gt; (Y − μ&lt;sup&gt;−&lt;/sup&gt;);  m&lt;sup&gt;+&lt;/sup&gt; = m&lt;sup&gt;−&lt;/sup&gt; + Δm&lt;br&gt;C = P&lt;sup&gt;−&lt;/sup&gt; − λ P&lt;sup&gt;−&lt;/sup&gt; J&lt;sup&gt;T&lt;/sup&gt; M&lt;sup&gt;−1&lt;/sup&gt; J P&lt;sup&gt;−&lt;/sup&gt; (exact affine C);  v&lt;sup&gt;+&lt;/sup&gt; = diag(C);  P&lt;sup&gt;+&lt;/sup&gt; = Diag(v&lt;sup&gt;+&lt;/sup&gt;) (projected)&lt;br&gt;Δc = η&lt;sub&gt;c&lt;/sub&gt; (1 − tanh(c)&lt;sup&gt;2&lt;/sup&gt;) ⊙ (W&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; Δm)  (deterministic observer canvas feedback)&lt;br&gt;&lt;br&gt;One frozen-affine EKF update per observation; PC multi-step settling is bypassed.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:161:1&quot;&gt;gaussian_uncertainty.py:161 — NumPy / CuPy and GLSL (:223)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="560" width="860" height="250" as="geometry"/></mxCell>
        <mxCell id="filter-lifecycle" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:203:1" value="&lt;b&gt;Lifecycle wiring&lt;/b&gt;&lt;br&gt;predict_visual(dt): optional gaze policy → shared OU mean/covariance forecast.&lt;br&gt;correct_from_observations(): joint affine condition → apply Δc to wave surface.&lt;br&gt;Ordinary PC mode (visual_uncertainty is None) remains unchanged.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:203:1&quot;&gt;orchestrator.py:203 (forecast/gaze); conditioning at line 320&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="640" height="150" as="geometry"/></mxCell>
        <mxCell id="filter-reference" link="vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_gaussian_uncertainty.py:54:1" value="&lt;b&gt;Limits and mathematical reference&lt;/b&gt;&lt;br&gt;D, τ, v&lt;sub&gt;0&lt;/sub&gt; are uncalibrated assumptions (v&lt;sub&gt;0&lt;/sub&gt; ≠ stationary ½ D τ). For ρ &amp;lt; 1, v&lt;sup&gt;−&lt;/sup&gt; relaxes toward ½ D τ without observing.&lt;br&gt;Hidden correlations in C are dropped; Δc is deterministic feedback, not wave covariance.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_gaussian_uncertainty.py:54:1&quot;&gt;Dense &amp;amp; scalar affine references: test_gaussian_uncertainty.py:54, :219&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="890" width="620" height="150" as="geometry"/></mxCell>
        <mxCell id="filter-mean-cov" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-mean" target="filter-cov" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-cov-freeze" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-cov" target="filter-freeze" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-freeze-condition" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.76744;entryY=0;" edge="1" source="filter-freeze" target="filter-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-evidence-condition" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="filter-evidence" target="filter-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="filter-memory" value="next frame: m+, P+" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=1;fontSize=14;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="filter-condition" target="filter-mean" parent="1">
          <mxGeometry relative="1" x="0.35" y="-15" as="geometry"><Array as="points"><mxPoint x="1400" y="685"/><mxPoint x="1400" y="150"/><mxPoint x="240" y="150"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-objective" name="3 - Sensory information objective">
    <mxGraphModel dx="1440" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="objective-title" value="3 / OBJECTIVE — Where would observing reduce sensory uncertainty?" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="objective-intro" value="With the scene prior fixed across gaze actions, maximizing IG minimizes expected remaining sensory uncertainty. The target is X, not sensor noise or diagnostic residual energy." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="50" as="geometry"/></mxCell>
        <mxCell id="objective-definition" value="&lt;b&gt;Expected information gain = conditional mutual information&lt;/b&gt;&lt;br&gt;&lt;br&gt;IG(a) = I(X&lt;sub&gt;t+1&lt;/sub&gt;; Y&lt;sub&gt;a&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;, c, W) = E&lt;sub&gt;Yₐ&lt;/sub&gt; [ KL(q(X&lt;sub&gt;t+1&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;, Y&lt;sub&gt;a&lt;/sub&gt;, a) ‖ q(X&lt;sub&gt;t+1&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;)) ]&lt;br&gt;The c, W conditions are suppressed on the right. Gaussian q is the local approximation; the expectation is evaluated analytically, before seeing Y&lt;sub&gt;a&lt;/sub&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="1320" height="150" as="geometry"/></mxCell>
        <mxCell id="objective-forecast" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1" value="&lt;b&gt;Forecast the next sensory covariance&lt;/b&gt;&lt;br&gt;&lt;br&gt;Start from the current posterior (m&lt;sup&gt;+&lt;/sup&gt;, P&lt;sup&gt;+&lt;/sup&gt;).&lt;br&gt;Apply the same OU transition (_transition(Δt)) and J.&lt;br&gt;Advice holds c&lt;sub&gt;t&lt;/sub&gt; fixed; policy uses next propagated prior.&lt;br&gt;V&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = J&lt;sub&gt;r&lt;/sub&gt; P&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; J&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt;: full local RGB covariance&lt;br&gt;&lt;br&gt;No future wave rollout or unseen camera region is modeled.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1&quot;&gt;expected_information_gain():322 — forecast / RGB projection&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="390" width="620" height="240" as="geometry"/></mxCell>
        <mxCell id="objective-action" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1" value="&lt;b&gt;Evaluate a hypothetical observation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Each candidate a supplies a different spatial field λ&lt;sub&gt;a&lt;/sub&gt;(r).&lt;br&gt;Assume Y&lt;sub&gt;a,r&lt;/sub&gt; = X&lt;sub&gt;r&lt;/sub&gt; + ε&lt;sub&gt;a,r&lt;/sub&gt;, R&lt;sub&gt;a,r&lt;/sub&gt; = λ&lt;sub&gt;a&lt;/sub&gt;(r)&lt;sup&gt;−1&lt;/sup&gt; I&lt;sub&gt;3&lt;/sub&gt;.&lt;br&gt;Independent pixels are summed; RGB correlations remain.&lt;br&gt;Zero precision contributes zero information.&lt;br&gt;&lt;br&gt;No actual future sample or evaluator truth is needed to score a.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/spatial_precision.py:46:1&quot;&gt;GaussianSpatialPrecision.field():46&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="390" width="620" height="240" as="geometry"/></mxCell>
        <mxCell id="objective-gain" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1" value="&lt;b&gt;Sensory information gain — natural logarithms, measured in nats&lt;/b&gt;&lt;br&gt;&lt;br&gt;IG(a) = ½ Σ&lt;sub&gt;r&lt;/sub&gt; ln det(I&lt;sub&gt;3&lt;/sub&gt; + λ&lt;sub&gt;a&lt;/sub&gt;(r) V&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;t&lt;sub&gt;1&lt;/sub&gt; = tr(V); t&lt;sub&gt;2&lt;/sub&gt; = Σ&lt;sub&gt;i&amp;lt;j&lt;/sub&gt;(V&lt;sub&gt;ii&lt;/sub&gt; V&lt;sub&gt;jj&lt;/sub&gt; − V&lt;sub&gt;ij&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt;); t&lt;sub&gt;3&lt;/sub&gt; = det(V)&lt;br&gt;Implemented quadrature: IĜ(a) = ½ Σ&lt;sub&gt;sampled r&lt;/sub&gt; w&lt;sub&gt;r&lt;/sub&gt; log1p(λ t&lt;sub&gt;1&lt;/sub&gt; + λ&lt;sup&gt;2&lt;/sup&gt; t&lt;sub&gt;2&lt;/sub&gt; + λ&lt;sup&gt;3&lt;/sup&gt; t&lt;sub&gt;3&lt;/sub&gt;)&lt;br&gt;w&lt;sub&gt;r&lt;/sub&gt; = w&lt;sub&gt;row&lt;/sub&gt; w&lt;sub&gt;col&lt;/sub&gt; pixel-area cell weights over [−½, R−½] × [−½, C−½] (Σ w&lt;sub&gt;r&lt;/sub&gt; = N). Valid for PSD V, including rank-deficient cases.&lt;br&gt;IG uses full local Gaussian conditioning, before the hidden-diagonal projection; it is not the entropy drop of the stored diagonal alone.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1&quot;&gt;gaussian_uncertainty.py:322 — CPU/CuPy scoring, GLSL moments/reduction (:377), _pixel_area_weights:491&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1320" height="250" as="geometry"/></mxCell>
        <mxCell id="objective-ui" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/gaze.py:42:1" value="&lt;b&gt;Gaze modes &amp;amp; evaluation metrics&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Mouse (default):&lt;/b&gt; manual gaze; IĜ overlay is advisory.&lt;br&gt;• &lt;b&gt;Autonomous (experiment / --active-vision):&lt;/b&gt; greedy argmax&lt;sub&gt;a&lt;/sub&gt; IĜ(a) per model step; holds gaze on tie/zero gain; no truth leakage.&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; uniform λ = 1 (not Observe off).&lt;br&gt;• &lt;b&gt;Metrics:&lt;/b&gt; ideal IĜ ≠ diagonal v&lt;sup&gt;+&lt;/sup&gt; ≠ next-frame image error.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/gaze.py:42:1&quot;&gt;gaze.py:42 (selector); active_vision_experiment.py:210; active_vision.py:75&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="640" height="180" as="geometry"/></mxCell>
        <mxCell id="objective-bounds" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1" value="&lt;b&gt;Bounded, approximate execution&lt;/b&gt;&lt;br&gt;9 × 13 candidate grid; pixel-area quadrature (max side 64).&lt;br&gt;Native backend covariance; OpenGL downloads 117 scores.&lt;br&gt;Preview overlay ≤ 10 Hz; autonomous mode steps at frame clock.&lt;br&gt;Narrow footprints may be missed by coarse spatial sampling.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_uncertainty.py:322:1&quot;&gt;gaussian_uncertainty.py:322 / _pixel_area_weights:491&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="740" y="1010" width="620" height="180" as="geometry"/></mxCell>
        <mxCell id="objective-forecast-gain" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.23485;entryY=0;" edge="1" source="objective-forecast" target="objective-gain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="objective-action-gain" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.76515;entryY=0;" edge="1" source="objective-action" target="objective-gain" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="objective-gain-ui" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.24242;exitY=1;entryX=0.5;entryY=0;" edge="1" source="objective-gain" target="objective-ui" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-audio" name="4 - Common-mode audio filter">
    <mxGraphModel dx="1440" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1180" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="audio-title" value="4 / AUDIO — Common-mode temporal Gaussian filter over a shared latent wave medium" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="audio-intro" value="Global 16-band spectrum y&lt;sub&gt;a&lt;/sub&gt; ∈ R&lt;sup&gt;16&lt;/sup&gt; has no spatial coordinates. Exact K × K covariance reduction holds under an explicit rank-K common-mode perturbation ξ&lt;sub&gt;t&lt;/sub&gt; ~ N(0, P&lt;sub&gt;a&lt;/sub&gt;) shared across all N pixels (Cov(h&lt;sub&gt;r&lt;/sub&gt;, h&lt;sub&gt;s&lt;/sub&gt;) = P&lt;sub&gt;a&lt;/sub&gt; ∀ r, s), not independent pixel priors." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1320" height="50" as="geometry"/></mxCell>
        <mxCell id="audio-evidence" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/audio.py:80:1" value="&lt;b&gt;1. Freshness-gated spectral evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;• STFT / mel block updates processor.frame_counter (~47.5 ms)&lt;br&gt;• &lt;b&gt;Fresh block:&lt;/b&gt; y&lt;sub&gt;a&lt;/sub&gt; ∈ R&lt;sup&gt;16&lt;/sup&gt; mono magnitude bands&lt;br&gt;• &lt;b&gt;Unchanged block:&lt;/b&gt; observation() → None (no re-assimilation; filter coasts via OU)&lt;br&gt;• Legacy peak-to-position sonification is inactive&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/audio.py:80:1&quot;&gt;audio.py:80; audio_features.py:9&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="380" height="250" as="geometry"/></mxCell>
        <mxCell id="audio-forecast" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:131:1" value="&lt;b&gt;2. Shared-medium OU forecast &amp;amp; rank-K prior&lt;/b&gt;&lt;br&gt;&lt;br&gt;h&lt;sub&gt;r,t&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; = m&lt;sub&gt;r,t&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; + ξ&lt;sub&gt;t&lt;/sub&gt;,  ξ&lt;sub&gt;t&lt;/sub&gt; ~ N(0, P&lt;sub&gt;a,t&lt;/sub&gt;),  P&lt;sub&gt;a&lt;/sub&gt; = Diag(v&lt;sub&gt;a&lt;/sub&gt;) ∈ R&lt;sup&gt;K×K&lt;/sup&gt;&lt;br&gt;Σ&lt;sub&gt;a&lt;/sub&gt; = (1&lt;sub&gt;N&lt;/sub&gt; 1&lt;sub&gt;N&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt;) ⊗ P&lt;sub&gt;a&lt;/sub&gt; = U P&lt;sub&gt;a&lt;/sub&gt; U&lt;sup&gt;T&lt;/sup&gt;,  U = 1&lt;sub&gt;N&lt;/sub&gt; ⊗ I&lt;sub&gt;K&lt;/sub&gt;&lt;br&gt;m&lt;sub&gt;r,t+1&lt;/sub&gt;&lt;sup&gt;(a)−&lt;/sup&gt; = ρ m&lt;sub&gt;r,t&lt;/sub&gt;&lt;sup&gt;(a)+&lt;/sup&gt; + (1 − ρ) W&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; tanh(c&lt;sub&gt;r,t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;v&lt;sub&gt;a,t+1&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = ρ&lt;sup&gt;2&lt;/sup&gt; v&lt;sub&gt;a,t&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; + Q(Δt) 1&lt;sub&gt;K&lt;/sub&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:131:1&quot;&gt;gaussian_audio_uncertainty.py:131 (predict)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="470" y="190" width="420" height="250" as="geometry"/></mxCell>
        <mxCell id="audio-jacobian" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:191:1" value="&lt;b&gt;3. Pooled decoder &amp;amp; common-mode Jacobian&lt;/b&gt;&lt;br&gt;&lt;br&gt;ŷ&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = W&lt;sub&gt;v&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; (1/N Σ&lt;sub&gt;r&lt;/sub&gt; tanh(m&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)−&lt;/sup&gt;)) ∈ R&lt;sup&gt;16&lt;/sup&gt;&lt;br&gt;s̄ = 1/N Σ&lt;sub&gt;r&lt;/sub&gt; (1 − tanh(m&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)−&lt;/sup&gt;)&lt;sup&gt;2&lt;/sup&gt;) ∈ R&lt;sup&gt;K&lt;/sup&gt;&lt;br&gt;J̄&lt;sub&gt;a&lt;/sub&gt; = J&lt;sub&gt;full&lt;/sub&gt; U = W&lt;sub&gt;v&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; Diag(s̄) ∈ R&lt;sup&gt;16×K&lt;/sup&gt;&lt;br&gt;V&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = J&lt;sub&gt;full&lt;/sub&gt; (U P&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; U&lt;sup&gt;T&lt;/sup&gt;) J&lt;sub&gt;full&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; = J̄&lt;sub&gt;a&lt;/sub&gt; P&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; J̄&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; ∈ R&lt;sup&gt;16×16&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:191:1&quot;&gt;gaussian_audio_uncertainty.py:191 (_pooled_jacobian)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="940" y="190" width="420" height="250" as="geometry"/></mxCell>
        <mxCell id="audio-condition" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:197:1" value="&lt;b&gt;4. Division-free K × K Woodbury posterior &amp;amp; synchronous pre-evidence canvas feedback&lt;/b&gt;&lt;br&gt;&lt;br&gt;A = J̄&lt;sub&gt;a&lt;/sub&gt; Diag(√v&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;) ∈ R&lt;sup&gt;16×K&lt;/sup&gt;;  M&lt;sub&gt;a&lt;/sub&gt; = I&lt;sub&gt;K&lt;/sub&gt; + λ&lt;sub&gt;a&lt;/sub&gt; A&lt;sup&gt;T&lt;/sup&gt; A ∈ R&lt;sup&gt;K×K&lt;/sup&gt;;  C&lt;sub&gt;a&lt;/sub&gt; = Diag(√v&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;) M&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−1&lt;/sup&gt; Diag(√v&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;br&gt;Δm&lt;sub&gt;a&lt;/sub&gt; = λ&lt;sub&gt;a&lt;/sub&gt; C&lt;sub&gt;a&lt;/sub&gt; J̄&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; (y&lt;sub&gt;a&lt;/sub&gt; − ŷ&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;) ∈ R&lt;sup&gt;K&lt;/sup&gt;;  m&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)+&lt;/sup&gt; = m&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)−&lt;/sup&gt; + Δm&lt;sub&gt;a&lt;/sub&gt; (uniform shift);  v&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = diag(C&lt;sub&gt;a&lt;/sub&gt;)&lt;br&gt;IG&lt;sub&gt;a&lt;/sub&gt; = ½ ln det(I&lt;sub&gt;16&lt;/sub&gt; + λ&lt;sub&gt;a&lt;/sub&gt; V&lt;sub&gt;a&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;) = ½ ln det(M&lt;sub&gt;a&lt;/sub&gt;)  (exact common-mode sensory MI in nats)&lt;br&gt;Δc&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt; = η&lt;sub&gt;c&lt;/sub&gt; (1 − tanh(c&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;2&lt;/sup&gt;) ⊙ (W&lt;sub&gt;c&lt;/sub&gt;&lt;sup&gt;(a)T&lt;/sup&gt; Δm&lt;sub&gt;a&lt;/sub&gt;)  evaluated at untouched pre-evidence c&lt;sup&gt;−&lt;/sup&gt;; total Δc&lt;sub&gt;r&lt;/sub&gt; = Δc&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(v)&lt;/sup&gt; + Δc&lt;sub&gt;r&lt;/sub&gt;&lt;sup&gt;(a)&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:197:1&quot;&gt;gaussian_audio_uncertainty.py:197 (condition:211 / _condition_native:267 / expected_information_gain:362)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="1320" height="240" as="geometry"/></mxCell>
        <mxCell id="audio-medium" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:320:1" value="&lt;b&gt;Shared latent support vs. cross-modal causality&lt;/b&gt;&lt;br&gt;• Wave canvas c is a shared deterministic dynamical substrate supporting both visual and audio projections.&lt;br&gt;• Sharing c does &lt;b&gt;not&lt;/b&gt; infer spatial sound localization or cross-modal posterior covariance.&lt;br&gt;• Both branches forecast and compute ∂tanh(c&lt;sup&gt;−&lt;/sup&gt;)/∂c&lt;sup&gt;−&lt;/sup&gt; from the same pre-evidence c&lt;sup&gt;−&lt;/sup&gt; before applying Δc&lt;sup&gt;(v)&lt;/sup&gt; + Δc&lt;sup&gt;(a)&lt;/sup&gt;.&lt;br&gt;• Visual gaze planning remains purely visual conditional on c.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/sources/orchestrator.py:320:1&quot;&gt;orchestrator.py:320 (correct_from_observations)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="650" height="230" as="geometry"/></mxCell>
        <mxCell id="audio-bounds" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:432:1" value="&lt;b&gt;Native execution &amp;amp; scope boundaries&lt;/b&gt;&lt;br&gt;• OpenGL reduces spatial slopes on GPU and downloads only (H,) mean slope, (H,) variance, and (16,) prediction for the tiny K × K host solve.&lt;br&gt;• belief_snapshot() exposes bounded host arrays: visual (H,), (3,), (3,3) at nearest gaze pixel; audio (H,), (16,), (16,16) (signal V = J P J&lt;sup&gt;T&lt;/sup&gt; without noise R).&lt;br&gt;• Fixed weights (learning off); emergent modality-specialized regions and learned cross-modal weights are future work.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/gaussian_audio_uncertainty.py:432:1&quot;&gt;belief_snapshot():432; test_gaussian_uncertainty.py:337&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="730" y="840" width="630" height="230" as="geometry"/></mxCell>
        <mxCell id="audio-ev-cond" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.1439;entryY=0;" edge="1" source="audio-evidence" target="audio-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="audio-fore-jac" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="audio-forecast" target="audio-jacobian" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="audio-jac-cond" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.8409;entryY=0;" edge="1" source="audio-jacobian" target="audio-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="audio-cond-med" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.2462;exitY=1;entryX=0.5;entryY=0;" edge="1" source="audio-condition" target="audio-medium" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="audio-memory" value="next frame: m_r(a)+, v_a+" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=1;fontSize=14;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="audio-condition" target="audio-forecast" parent="1">
          <mxGeometry relative="1" x="0.25" y="-15" as="geometry"><Array as="points"><mxPoint x="1400" y="640"/><mxPoint x="1400" y="145"/><mxPoint x="680" y="145"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uncertainty-shared-graph" name="5 - Shared learned sensory graph">
    <mxGraphModel dx="1440" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1200" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="shared-title" value="5 / SHARED GRAPH — Opt-in learned Gaussian sensory/latent graph with hard evidence clamps" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1320" height="40" as="geometry"/></mxCell>
        <mxCell id="shared-intro" value="Activated via --shared-sensory-graph (with --active-vision; --active-audio optional). Replaces separate per-pixel visual / audio hidden fields with ONE compact joint Gaussian x = (x&lt;sub&gt;V&lt;/sub&gt;, x&lt;sub&gt;A&lt;/sub&gt;, x&lt;sub&gt;H&lt;/sub&gt;) ∈ R&lt;sup&gt;M&lt;/sup&gt; (M ≤ 96; default 48 RGB + 16 audio + 8 free hidden = 72) and learned SPD population N(μ, C)." style="text;whiteSpace=wrap;html=1;fontSize=16;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="75" width="1320" height="45" as="geometry"/></mxCell>
        <mxCell id="shared-nodes" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:80:1" value="&lt;b&gt;1. Compact node layout &amp;amp; learned N(μ, C)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• x&lt;sub&gt;V&lt;/sub&gt; ∈ R&lt;sup&gt;3 R₀ C₀&lt;/sup&gt;: compact RGB grid (R₀, C₀ ≤ 4, default 4×4 = 48)&lt;br&gt;• x&lt;sub&gt;A&lt;/sub&gt; ∈ R&lt;sup&gt;16&lt;/sup&gt;: global spectral audio ports&lt;br&gt;• x&lt;sub&gt;H&lt;/sub&gt; ∈ R&lt;sup&gt;8&lt;/sup&gt;: free internal hidden units (shared across tabs)&lt;br&gt;• Learned μ ∈ R&lt;sup&gt;M&lt;/sup&gt;, SPD C ∈ R&lt;sup&gt;M×M&lt;/sup&gt; (precision Λ = C&lt;sup&gt;−1&lt;/sup&gt;), exchangeable seeded correlations (λ&lt;sub&gt;min&lt;/sub&gt;(C) ≥ ε&lt;sub&gt;floor&lt;/sub&gt;)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:80:1&quot;&gt;shared_sensory_graph.py:80; shared_sensory_io.py:8&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="410" height="260" as="geometry"/></mxCell>
        <mxCell id="shared-forecast" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:237:1" value="&lt;b&gt;2. Held-parameter joint OU forecast&lt;/b&gt;&lt;br&gt;&lt;br&gt;ρ = exp(−Δt / τ),  C&lt;sub&gt;∞&lt;/sub&gt; = C + ½ D τ I&lt;sub&gt;M&lt;/sub&gt;&lt;br&gt;m&lt;sup&gt;−&lt;/sup&gt; = ρ m&lt;sup&gt;+&lt;/sup&gt; + (1 − ρ) μ&lt;br&gt;P&lt;sup&gt;−&lt;/sup&gt; = ρ&lt;sup&gt;2&lt;/sup&gt; P&lt;sup&gt;+&lt;/sup&gt; + (1 − ρ&lt;sup&gt;2&lt;/sup&gt;) C&lt;sub&gt;∞&lt;/sub&gt;&lt;br&gt;&lt;br&gt;ŷ&lt;sub&gt;V&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = BilinearInterp(m&lt;sub&gt;V&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;),  ŷ&lt;sub&gt;A&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; = m&lt;sub&gt;A&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:237:1&quot;&gt;forecast():237; SharedSensoryIO.render():113&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="500" y="190" width="400" height="260" as="geometry"/></mxCell>
        <mxCell id="shared-clamps" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_io.py:72:1" value="&lt;b&gt;3. Active sensory clamp set O ⊆ V ∪ A&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Mouse / Autonomous:&lt;/b&gt; nearest 4×4 RGB sample + centers within 1σ fovea (≥ 1 sample when Observe on)&lt;br&gt;• &lt;b&gt;Full canvas:&lt;/b&gt; all 48 RGB nodes; &lt;b&gt;Observe off:&lt;/b&gt; O&lt;sub&gt;V&lt;/sub&gt; = ∅&lt;br&gt;• &lt;b&gt;Audio:&lt;/b&gt; fresh block clamps 16 bands (silent y&lt;sub&gt;A&lt;/sub&gt; = 0 clamps to 0; off or unchanged block ⇒ O&lt;sub&gt;A&lt;/sub&gt; = ∅, free)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_io.py:72:1&quot;&gt;SharedSensoryIO.sample():72 / visual_mask():94&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="950" y="190" width="410" height="260" as="geometry"/></mxCell>
        <mxCell id="shared-condition" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:370:1" value="&lt;b&gt;4. Exact hard-clamp conditioning on N(m&lt;sup&gt;−&lt;/sup&gt;, P&lt;sup&gt;−&lt;/sup&gt;) &amp;amp; masked online Gaussian moment/EM learning on N(μ, C)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Filter posterior (U = {1..M} \ O):&lt;/b&gt;  m&lt;sub&gt;O&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = y&lt;sub&gt;O&lt;/sub&gt;,  m&lt;sub&gt;U&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = m&lt;sub&gt;U&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; + P&lt;sub&gt;UO&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; (P&lt;sub&gt;OO&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;−1&lt;/sup&gt; (y&lt;sub&gt;O&lt;/sub&gt; − m&lt;sub&gt;O&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;),  P&lt;sub&gt;UU&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = P&lt;sub&gt;UU&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; − P&lt;sub&gt;UO&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; (P&lt;sub&gt;OO&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;−1&lt;/sup&gt; P&lt;sub&gt;OU&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;,  P&lt;sub&gt;O,·&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = P&lt;sub&gt;·,O&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = 0&lt;br&gt;• &lt;b&gt;Canvas feedback:&lt;/b&gt;  Δc = BilinearInterp(η&lt;sub&gt;c&lt;/sub&gt; (m&lt;sub&gt;V&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; − m&lt;sub&gt;V&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;));  if O = ∅: m&lt;sup&gt;+&lt;/sup&gt; = m&lt;sup&gt;−&lt;/sup&gt;, P&lt;sup&gt;+&lt;/sup&gt; = P&lt;sup&gt;−&lt;/sup&gt;, Δc = 0, and &lt;b&gt;(μ, C) do not update&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Population E-step from N(μ, C) | (x&lt;sub&gt;O&lt;/sub&gt; = y&lt;sub&gt;O&lt;/sub&gt;) (not filter posterior):&lt;/b&gt;  u&lt;sub&gt;O&lt;/sub&gt; = y&lt;sub&gt;O&lt;/sub&gt;,  u&lt;sub&gt;U&lt;/sub&gt; = μ&lt;sub&gt;U&lt;/sub&gt; + C&lt;sub&gt;UO&lt;/sub&gt; C&lt;sub&gt;OO&lt;/sub&gt;&lt;sup&gt;−1&lt;/sup&gt; (y&lt;sub&gt;O&lt;/sub&gt; − μ&lt;sub&gt;O&lt;/sub&gt;),  V&lt;sub&gt;UU&lt;/sub&gt; = C&lt;sub&gt;UU&lt;/sub&gt; − C&lt;sub&gt;UO&lt;/sub&gt; C&lt;sub&gt;OO&lt;/sub&gt;&lt;sup&gt;−1&lt;/sup&gt; C&lt;sub&gt;OU&lt;/sub&gt;,  V&lt;sub&gt;O,·&lt;/sub&gt; = V&lt;sub&gt;·,O&lt;/sub&gt; = 0&lt;br&gt;• &lt;b&gt;Regularized M-step (α ∈ [0,1]):&lt;/b&gt;  d = u − μ,  μ′ = μ + α d,  C′ = (1 − α) C + α V + α(1 − α) d d&lt;sup&gt;T&lt;/sup&gt; + α ε&lt;sub&gt;floor&lt;/sub&gt; I&lt;sub&gt;M&lt;/sub&gt;  (eigenvalues floored at ε&lt;sub&gt;floor&lt;/sub&gt;)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:370:1&quot;&gt;shared_sensory_graph.py:370 (condition / _conditional_gaussian:314); orchestrator.py:320&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="1320" height="250" as="geometry"/></mxCell>
        <mxCell id="shared-ig" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:454:1" value="&lt;b&gt;5. Finite hidden-target mutual information (nats)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hard-clamping S has infinite self-MI I(X&lt;sub&gt;S&lt;/sub&gt;; X&lt;sub&gt;S&lt;/sub&gt;). Instead, score information gained about the &lt;b&gt;free internal hidden units H&lt;/b&gt; from clamping sensory subset S ⊆ V ∪ A:&lt;br&gt;IG&lt;sub&gt;H&lt;/sub&gt;(S) = I(X&lt;sub&gt;H&lt;/sub&gt;; X&lt;sub&gt;S&lt;/sub&gt; | D&lt;sub&gt;t&lt;/sub&gt;) = ½ ln ( det P&lt;sub&gt;HH&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; / det(P&lt;sub&gt;HH&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; − P&lt;sub&gt;HS&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt; (P&lt;sub&gt;SS&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;)&lt;sup&gt;−1&lt;/sup&gt; P&lt;sub&gt;SH&lt;/sub&gt;&lt;sup&gt;−&lt;/sup&gt;) )&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:454:1&quot;&gt;information_gain():454; visual_information_gain():241&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="650" height="240" as="geometry"/></mxCell>
        <mxCell id="shared-bounds" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:502:1" value="&lt;b&gt;6. Scope, identifiability &amp;amp; backend execution&lt;/b&gt;&lt;br&gt;• Learns empirical co-occurrence covariance C; free hidden units H are rotation/permutation unidentifiable and are &lt;b&gt;not&lt;/b&gt; guaranteed to form spatially segregated modality territories.&lt;br&gt;• Compact 4×4 RGB ports (48 floats gathered on GPU, bilinearly interpolated to canvas), not dense 1080p pixel covariance; assigned-precision spinboxes hidden.&lt;br&gt;• NumPy/CuPy solve on backend; OpenGL runs tiny 72×72 host Gaussian solve while keeping camera preprocess, 48-float RGB gather, and full-grid bilinear render on GPU.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_graph.py:502:1&quot;&gt;belief_snapshot():502; test_shared_sensory_graph.py:9&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="730" y="860" width="630" height="240" as="geometry"/></mxCell>
        <mxCell id="shared-nodes-fore" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="shared-nodes" target="shared-forecast" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shared-fore-cond" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="shared-forecast" target="shared-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shared-clamp-cond" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;entryX=0.8447;entryY=0;" edge="1" source="shared-clamps" target="shared-condition" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shared-cond-ig" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.2462;exitY=1;entryX=0.5;entryY=0;" edge="1" source="shared-condition" target="shared-ig" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="shared-memory" value="next frame: m+, P+ and learned μ′, C′" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;dashed=1;fontSize=14;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" source="shared-condition" target="shared-forecast" parent="1">
          <mxGeometry relative="1" x="0.25" y="-15" as="geometry"><Array as="points"><mxPoint x="1400" y="655"/><mxPoint x="1400" y="155"/><mxPoint x="700" y="155"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="rc-spiking-visual-circuit" name="6 - RC-spiking visual circuit">
    <mxGraphModel dx="1440" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1440" pageHeight="1180" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="rc-title" value="6 / RC-SPIKING VISUAL CIRCUIT — Bias-free continuous leaky integrate-and-fire predictive coding (no wave equation)" style="text;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1360" height="35" as="geometry"/></mxCell>
        <mxCell id="rc-intro" value="Worked visual loop over one physical interval [t, t + Δt] subdivided into M micro-steps δt = Δt / M. With τ = R C, per-microstep retention is α = exp(−δt / τ) and exact zero-order-hold (ZOH) input gain is β = (τ (1 − α) / C) η = R (1 − α) η. Biases are permanently disabled (b_h = 0, b_s = 0) so no constant DC battery prevents decay." style="text;whiteSpace=wrap;html=1;fontSize=15;align=left;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="40" y="65" width="1360" height="45" as="geometry"/></mxCell>
        <mxCell id="rc-cam" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_io.py:85:1" value="&lt;b&gt;1. Foveal Camera Input&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Circular fovea (K disk pixels, 3K RGB slots)&lt;br&gt;• Observed pixel RGB: y ∈ [0, 1]&lt;sup&gt;3K&lt;/sup&gt;&lt;br&gt;• Valid aperture mask O ⊆ {1..3K}&lt;br&gt;• &lt;b&gt;Observe off:&lt;/b&gt; O = ∅ (no sensory current)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/shared_sensory_io.py:85:1&quot;&gt;shared_sensory_io.py:85 (route / sample)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="350" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-err" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:249:1" value="&lt;b&gt;2. Prediction Error &amp;amp; Error RC Membrane (v&lt;sub&gt;e&lt;/sub&gt;, s&lt;sub&gt;e&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Residual current: e&lt;sub&gt;s&lt;/sub&gt; = 1&lt;sub&gt;O&lt;/sub&gt; ⊙ (y − ŷ(h))&lt;br&gt;• Leaky RC integration: v&lt;sub&gt;e&lt;/sub&gt; ← 1&lt;sub&gt;O&lt;/sub&gt; ⊙ (α v&lt;sub&gt;e&lt;/sub&gt; + β e&lt;sub&gt;s&lt;/sub&gt;)&lt;br&gt;• Ternary error spikes: s&lt;sub&gt;e&lt;/sub&gt; = sign(v&lt;sub&gt;e&lt;/sub&gt;) ⊙ (|v&lt;sub&gt;e&lt;/sub&gt;| ≥ θ) ∈ {−1, 0, +1}&lt;sup&gt;3K&lt;/sup&gt;&lt;br&gt;• Subtractive voltage reset: v&lt;sub&gt;e&lt;/sub&gt; ← v&lt;sub&gt;e&lt;/sub&gt; − θ s&lt;sub&gt;e&lt;/sub&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:249:1&quot;&gt;rc_spiking_predictive_coding.py:249 (_terms_for / _emit_ternary_spikes:301)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="440" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-syn" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:548:1" value="&lt;b&gt;3. Synaptic Current &amp;amp; Hidden RC Membrane (v&lt;sub&gt;h&lt;/sub&gt;, s&lt;sub&gt;h&lt;/sub&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Local Jacobian: J&lt;sub&gt;s&lt;/sub&gt;(h) = ∂ŷ / ∂h = diag(ŷ ⊙ (1 − ŷ)) W&lt;sub&gt;s&lt;/sub&gt; diag(1 − tanh(h)&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;• Incoming current: I&lt;sub&gt;h&lt;/sub&gt; = clip(J&lt;sub&gt;s&lt;/sub&gt;(h)&lt;sup&gt;T&lt;/sup&gt; s&lt;sub&gt;e&lt;/sub&gt; + W&lt;sub&gt;h&lt;/sub&gt; (θ s&lt;sub&gt;h&lt;/sub&gt;&lt;sup&gt;prev&lt;/sup&gt;), −g&lt;sub&gt;max&lt;/sub&gt;, g&lt;sub&gt;max&lt;/sub&gt;)&lt;br&gt;• Hidden RC voltage: v&lt;sub&gt;h&lt;/sub&gt; ← α v&lt;sub&gt;h&lt;/sub&gt; + β I&lt;sub&gt;h&lt;/sub&gt;&lt;br&gt;• Ternary hidden spikes: s&lt;sub&gt;h&lt;/sub&gt; = sign(v&lt;sub&gt;h&lt;/sub&gt;) ⊙ (|v&lt;sub&gt;h&lt;/sub&gt;| ≥ θ),  v&lt;sub&gt;h&lt;/sub&gt; ← v&lt;sub&gt;h&lt;/sub&gt; − θ s&lt;sub&gt;h&lt;/sub&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:548:1&quot;&gt;rc_spiking_predictive_coding.py:548 (condition micro-step loop)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="390" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-cap" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:561:1" value="&lt;b&gt;4. Postsynaptic RC Belief Capacitor (h ∈ R&lt;sup&gt;H&lt;/sup&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Charge transfer: h ← α h + θ s&lt;sub&gt;h&lt;/sub&gt;&lt;br&gt;• Subtractive reset on v&lt;sub&gt;h&lt;/sub&gt; transfers discrete charge +θ s&lt;sub&gt;h&lt;/sub&gt; into h (does not erase represented belief)&lt;br&gt;• Holding a non-zero belief h against the passive RC leak (1 − α) h requires ongoing tonic spikes s&lt;sub&gt;h&lt;/sub&gt; ≠ 0&lt;br&gt;• Optional local Hebbian weight update after step: ΔW&lt;sub&gt;s&lt;/sub&gt; ∝ (e&lt;sub&gt;s&lt;/sub&gt; ⊙ ŷ ⊙ (1 − ŷ)) tanh(h)&lt;sup&gt;T&lt;/sup&gt;,  ΔW&lt;sub&gt;h&lt;/sub&gt; ∝ e&lt;sub&gt;h&lt;/sub&gt; tanh(h)&lt;sup&gt;T&lt;/sup&gt;&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:561:1&quot;&gt;rc_spiking_predictive_coding.py:561 (decoded state + _weight_gradients:289)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="760" y="470" width="640" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-dec" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:258:1" value="&lt;b&gt;5. Bias-Free Visual Decoder (ŷ ∈ (0, 1)&lt;sup&gt;3K&lt;/sup&gt;)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Nonlinear readout: ŷ(h) = σ(W&lt;sub&gt;s&lt;/sub&gt; tanh(h))  with b&lt;sub&gt;s&lt;/sub&gt; ≡ 0&lt;br&gt;• When h = 0: ŷ(0) = σ(0) = 0.5 (exact neutral gray rest state)&lt;br&gt;• Counterfactual prior forecast ŷ&lt;sup&gt;−&lt;/sup&gt; at t + Δt is evaluated before conditioning on y&lt;br&gt;• Closes the visual predictive loop by supplying ŷ(h) back to the comparator (Box 2)&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:258:1&quot;&gt;rc_spiking_predictive_coding.py:258 (decoder); static_world_metrics.py:67&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="610" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-decay" link="vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_rc_spiking_predictive_coding.py:257:1" value="&lt;b&gt;6. Why disabling biases restores genuine RC decay when Observe is off&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;With biases enabled (old):&lt;/b&gt; learned b&lt;sub&gt;h&lt;/sub&gt; ≠ 0 acts as a non-decaying DC current source charging v&lt;sub&gt;h&lt;/sub&gt; every step (firing 48/48 tonic spikes), and b&lt;sub&gt;s&lt;/sub&gt; ≠ 0 holds σ(b&lt;sub&gt;s&lt;/sub&gt;) ≠ 0.5 even at h = 0.&lt;br&gt;• &lt;b&gt;Bias-free RC circuit (current):&lt;/b&gt; b&lt;sub&gt;h&lt;/sub&gt; ≡ 0, b&lt;sub&gt;s&lt;/sub&gt; ≡ 0; only synaptic weights (W&lt;sub&gt;s&lt;/sub&gt;, W&lt;sub&gt;h&lt;/sub&gt;, W&lt;sub&gt;c&lt;/sub&gt;) learn.&lt;br&gt;• When &lt;b&gt;Observe is off&lt;/b&gt; (O = ∅, r = 0): e&lt;sub&gt;s&lt;/sub&gt; = 0 ⇒ s&lt;sub&gt;e&lt;/sub&gt; = 0. Once residual v&lt;sub&gt;h&lt;/sub&gt; drops below θ, s&lt;sub&gt;h&lt;/sub&gt; = 0 and h(t + k Δt) = exp(−k Δt / τ) h(t) → 0, so ŷ(h) → σ(0) = 0.5.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/tests/readouts/test_rc_spiking_predictive_coding.py:257:1&quot;&gt;test_rc_spiking_predictive_coding.py:257 (learned weights + Observe-off decay)&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="780" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-single-clock" link="vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:317:1" value="&lt;b&gt;7. Single-clock ZOH invariant &amp;amp; display cache boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;M-invariant drive:&lt;/b&gt; Σ&lt;sub&gt;m=0..M−1&lt;/sub&gt; α&lt;sup&gt;m&lt;/sup&gt; β = (τ (1 − exp(−Δt / τ)) / C) η is independent of M.&lt;br&gt;• &lt;b&gt;Single Δt clock:&lt;/b&gt; forecast() rolls out counterfactual [t, t+Δt]; condition() replays the &lt;i&gt;same&lt;/i&gt; [t, t+Δt] from saved start state with evidence (never two Δt leaks).&lt;br&gt;• &lt;b&gt;Fovea vs. world cache:&lt;/b&gt; current foveal ŷ(h) decays to 0.5; outside-fovea world canvas retains last-written pixels until revisited.&lt;br&gt;&lt;a href=&quot;vscode://file/home/nicklas/Projects/AudioViz/src/audioviz/readouts/rc_spiking_predictive_coding.py:317:1&quot;&gt;_substep_factors():317; forecast():420; condition():481&lt;/a&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2937;fontSize=15;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="860" y="780" width="540" height="230" as="geometry"/></mxCell>
        <mxCell id="rc-edge-cam-err" value="y" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;fontSize=13;fontColor=#4b365f;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="rc-cam" target="rc-err" parent="1"><mxGeometry relative="1" y="-14" as="geometry"/></mxCell>
        <mxCell id="rc-edge-err-syn" value="s_e" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;fontSize=13;fontColor=#7f2f2b;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="rc-err" target="rc-syn" parent="1"><mxGeometry relative="1" y="-14" as="geometry"/></mxCell>
        <mxCell id="rc-edge-syn-cap" value="+θ s_h" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;fontSize=13;fontColor=#2b4c7e;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.71;entryY=0;" edge="1" source="rc-syn" target="rc-cap" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rc-edge-cap-dec" value="h(t)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=13;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="rc-cap" target="rc-dec" parent="1"><mxGeometry relative="1" y="-14" as="geometry"/></mxCell>
        <mxCell id="rc-edge-dec-err" value="ŷ(h)" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=13;fontColor=#3b6330;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.25;entryY=1;" edge="1" source="rc-dec" target="rc-err" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="425"/><mxPoint x="590" y="425"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
